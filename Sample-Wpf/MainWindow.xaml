<Window x:Class="Sample_Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sample_Wpf"
		xmlns:l="pattech.words"
        mc:Ignorable="d"
        Title="{l:Words main.title}" Height="450" Width="800">
    <Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="32" />
			<RowDefinition />
			<RowDefinition Height="32" />
			<RowDefinition />
			<RowDefinition Height="32"/>
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal">
			
		</StackPanel>
		<TreeView Grid.Row="1" Grid.RowSpan="3" ItemsSource="{Binding Keys}" />

		<TextBlock Grid.Column="1" Text="file/group.key" />
		<ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<TextBox Margin="5,5,45,5" />
				<TextBox Margin="45,5,5,5" />
			</StackPanel>
		</ScrollViewer>
		<StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
			
		</StackPanel>

		<ComboBox Grid.Column="2" ItemsSource="{Binding Languages}" />
		<ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<TextBox Margin="5,5,45,5" />
				<TextBox Margin="45,5,5,5" />
			</StackPanel>
		</ScrollViewer>
		<StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">

		</StackPanel>
	</Grid>
</Window>
