<UserControl x:Class="Sample_Wpf.Views.LivePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:c="clr-namespace:Sample_Wpf.Controls">
  <!-- Live switching. The builder was kept live at startup (App.OnStartup), so the
       language picker up top relocalizes every {l:Words}, bound or not, and every
       WordsInline in place. These two are {l:Words} wrapped around a binding -->
  <StackPanel>
    <!-- card: live.bound-key -->
    <c:DemoCard Key="live.bound-key" Uses="{}{l:Words {Binding}}">
      <!-- the view model picks the key by the theme; the binding's value is looked up -->
      <TextBlock TextWrapping="Wrap" Text="{l:Words {Binding ThemeKey}}"/>
    </c:DemoCard>
    <!-- /card -->

    <!-- card: live.converted -->
    <c:DemoCard Key="live.converted" Uses="{}{l:Words {Binding}}, WordsConverter">
      <StackPanel>
        <!-- the binding's own converter formats; live, it runs again on a switch too -->
        <TextBlock TextWrapping="Wrap" Text="{l:Words {Binding Count, Converter={StaticResource WordsFormat}, ConverterParameter=live.converted.demo}}"/>
        <Slider Margin="0,6,0,0" Minimum="0" Maximum="42" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Count}"/>
      </StackPanel>
    </c:DemoCard>
    <!-- /card -->

    <!-- card: live.kept -->
    <c:DemoCard Key="live.kept" Uses="IKnowWords, Words.Watch">
      <!-- plain bindings to strings the view model composed: only the one it composes
           again in IKnowWords.Refresh follows a switch -->
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Text="{Binding Kept}"/>
        <TextBlock TextWrapping="Wrap" Text="{Binding Watched}"/>
      </StackPanel>
    </c:DemoCard>
    <!-- /card -->
  </StackPanel>
</UserControl>
