<Window x:Class="Sample_Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="https://github.com/pzahra/words"
        xmlns:vm="clr-namespace:Sample_Shared.ViewModels;assembly=Sample-Shared"
        xmlns:v="clr-namespace:Sample_Wpf.Views"
        Title="{l:Words main.title}"
        Width="980" Height="760"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">
  <!-- The shell (Sample-Shared/SPEC.md): the title, language and theme across the top;
       the topics down the left, each with a dot until its latest revision is seen; the
       open topic's page on the right. Each page is its own view in Views/Pages, found
       here by its view model's type; the view models are Sample-Shared's. -->

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <DataTemplate DataType="{x:Type vm:StartPageViewModel}"><v:StartPageView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MarkdownPageViewModel}"><v:MarkdownPageView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LinksPageViewModel}"><v:LinksPageView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ImagesPageViewModel}"><v:ImagesPageView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ParametersPageViewModel}"><v:ParametersPageView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LivePageViewModel}"><v:LivePageView/></DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- across the top: what affects every page. Picking a language switches the window
         in place (live mode); both picks are remembered in the config -->
    <Border DockPanel.Dock="Top" Padding="18,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorder}">
      <DockPanel>
        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0"
                  Foreground="{DynamicResource WindowForeground}"
                  Content="{l:Words main.dark-theme}"
                  IsChecked="{Binding IsDarkTheme}"/>
        <ComboBox DockPanel.Dock="Right" MinWidth="140" VerticalAlignment="Center"
                  ItemsSource="{Binding Languages}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  SelectedValue="{Binding SelectedLanguage}"
                  ToolTip="{l:Words main.language}"/>
        <TextBlock FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Text="{l:Words main.title}"/>
      </DockPanel>
    </Border>

    <!-- down the left: the topics. A caption is a bound key, so the list follows a switch -->
    <ListBox DockPanel.Dock="Left" Width="220" Padding="6,8"
             Background="{DynamicResource PaneBackground}" BorderThickness="0"
             Foreground="{DynamicResource WindowForeground}"
             HorizontalContentAlignment="Stretch"
             ItemsSource="{Binding Pages}"
             SelectedItem="{Binding SelectedPage}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4,5">
            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                     Fill="{StaticResource UnseenBrush}"
                     ToolTip="{l:Words topic.unseen}"
                     Visibility="{Binding IsUnseen, Converter={StaticResource Visible}}"/>
            <TextBlock Text="{l:Words {Binding CaptionKey}}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- on the right: the open topic's page, under its caption -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,18" MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" Text="{l:Words {Binding SelectedPage.CaptionKey}}"/>
        <ContentControl Content="{Binding SelectedPage}" Focusable="False"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
