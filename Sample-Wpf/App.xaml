<Application x:Class="Sample_Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:c="clr-namespace:Sample_Wpf.Controls">
    <!-- no StartupUri: OnStartup builds the window so it can hand over the view model -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- the package's ready-made converters: WordsMarkdown, WordsFormat,
                     WordsEnumDescription, WordsFlagsDescription(List), WordsParamsArray, WordsResourceVisual;
                     and the look of rendered links and code spans, which the theme below may override -->

                <ResourceDictionary Source="pack://application:,,,/PatTech.Localization.WPF;component/Converters.xaml"/>
                <!-- the theme: window, pane and card brushes and the sun/moon ThemeIcon.
                     App.ApplyTheme swaps this entry for Dark.xaml, and everything
                     referencing it follows -->
                <ResourceDictionary Source="pack://application:,,,/Sample-Wpf;component/Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- resolved by markdown images through the staticres: and dynres: schemes -->
            <Geometry x:Key="StarGeometry">M 8,0 L 10.47,5.53 16,6.11 11.8,9.88 13.06,16 8,12.94 2.94,16 4.2,9.88 0,6.11 5.53,5.53 Z</Geometry>
            <!-- an element can't be shared between images, so a DataTemplate is its reusable form: loaded fresh each time -->
            <DataTemplate x:Key="HeartTemplate">
                <Path Data="M 8,14 C 8,14 1,9 1,5 A 3.5,3.5 0 0 1 8,4 A 3.5,3.5 0 0 1 15,5 C 15,9 8,14 8,14 Z" Fill="Crimson" Stretch="Uniform"/>
            </DataTemplate>
            <!-- the dot beside a topic not yet seen at its latest revision: one colour, both themes -->
            <SolidColorBrush x:Key="UnseenBrush" Color="#E8590C"/>
            <!-- WPF's check boxes default to the system's text colour; follow the theme instead -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            </Style>
            <!-- WPF's expander draws its arrow in the system's colours too: a plain one that
                 follows the theme, a triangle that turns as it opens -->
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Left" Cursor="Hand" Focusable="True">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                <TextBlock x:Name="Arrow" Text="&#x25B8;" Margin="0,0,5,0"/>
                                                <ContentPresenter/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value="&#x25BE;"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- a card's How: the files it is made of, cut from the real ones -->
            <c:CardHowConverter x:Key="CardHow"/>

            <!-- a demonstration: heading and guidance (filled by DemoCard from its Key),
                 the live result, chips naming what it uses, and how it is made: each file's
                 part under a label naming it, as text to select and copy -->
            <Style TargetType="c:DemoCard">
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="c:DemoCard">
                            <Border Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock x:Name="PART_Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PART_Guide" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                    <ContentPresenter/>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Text="{l:Words card.uses}" Opacity="0.6" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ItemsControl ItemsSource="{TemplateBinding UsesList}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ChipBackground}" CornerRadius="3" Padding="6,1" Margin="0,0,4,2">
                                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                    <Expander Header="{l:Words card.how}" FontSize="11" Margin="0,6,0,0">
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource CardHow}">
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                    <Binding Path="Key" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                    <Binding Path="MoreKeys" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,6,0,0">
                                                        <TextBlock Opacity="0.6"><l:WordsInline Key="card.how.from" Params="{Binding}"/></TextBlock>
                                                        <!-- read-only text, so it can be selected and copied; in the
                                                             code spans' font and tint, long lines wrapped -->
                                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                                 FontFamily="{DynamicResource WordsCodeFont}" FontSize="12"
                                                                 Background="{DynamicResource WordsCodeBackground}" Foreground="{DynamicResource WindowForeground}"
                                                                 BorderThickness="0" Padding="4,2" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
