<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PatTech.Localization.Authoring</RootNamespace>
    <AssemblyName>PatTech.Localization.Authoring</AssemblyName>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- tooling layer for editing words.ini files; deliberately not packaged,
         so the runtime packages stay lean -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Localization-Core\Localization-Core.csproj" />
  </ItemGroup>

</Project>
