<!--
    Ready-made converter instances. Merge once in App.xaml:

    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="pack://application:,,,/PatTech.Localization.WPF;component/Converters.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Application.Resources>

    and every view can say {StaticResource WordsMarkdown} and friends. The
    last three resources colour markdown links and style code spans; define
    your own under the same keys, in your theme, to restyle them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:PatTech.Localization.Wpf">
  <l:MarkdownConverter x:Key="WordsMarkdown"/>
  <l:WordsConverter x:Key="WordsFormat"/>
  <l:EnumDescriptionConverter x:Key="WordsEnumDescription"/>
  <l:FlagsDescriptionConverter x:Key="WordsFlagsDescription" AsArray="False"/>
  <l:FlagsDescriptionConverter x:Key="WordsFlagsDescriptionList"/>
  <l:ArrayMultiConverter x:Key="WordsParamsArray"/>
  <l:ResourceVisualConverter x:Key="WordsResourceVisual"/>
  <SolidColorBrush x:Key="WordsLinkBrush" Color="Blue"/>
  <FontFamily x:Key="WordsCodeFont">Consolas, Courier New</FontFamily>
  <SolidColorBrush x:Key="WordsCodeBackground" Color="#22808080"/>
</ResourceDictionary>
