<idea-plugin>
    <id>ai.evosonic.wordsxaml</id>
    <name>Words XAML</name>
    <vendor email="PatrickZ@evosonic.ai">Evosonic</vendor>

    <description><![CDATA[
        Autocomplete and tooltip preview for <code>{l:Words ...}</code> keys in Avalonia XAML,
        resolved against the solution's <code>*-words.ini</code> files.
    ]]></description>

    <!-- Marks this as a Rider (ReSharper-backend) plugin. The backend assemblies in the plugin's
         dotnet/ folder are loaded by the Rider ReSharper host; there is no JVM-side code. -->
    <depends>com.intellij.modules.rider</depends>
</idea-plugin>
