<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\GitDescribe.targets" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PatTech.Localization.Avalonia</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>PatTech.Localization.Avalonia</PackageId>
    <Title>Words for Avalonia</Title>
    <Description>Puts Words in the AXAML: the {l:Words key} markup extension, WordsInline for markdown-rendered strings, converters and image schemes over PatTech.Localization.Core.</Description>
    <PackageTags>localization;i18n;l10n;translation;avalonia;axaml;markup-extension;markdown</PackageTags>
    <AssemblyName>PatTech.Localization.Avalonia</AssemblyName>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[11.0, 12.0)" />
    <ProjectReference Include="..\Localization-Core\Localization-Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Localization-Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
