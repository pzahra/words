<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\GitDescribe.targets" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <RootNamespace>PatTech.Localization</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>PatTech.Localization.Core</PackageId>
    <AssemblyName>PatTech.Localization.Core</AssemblyName>
    <Title>Words</Title>
    <Description>Gives you Words: every user-facing string in a words.ini, looked up by key in the right language — fallbacks, {0} and {Name} parameters, {>key} references, a markdown dialect. The engine; pair it with PatTech.Localization.WPF or PatTech.Localization.Avalonia for XAML.</Description>
    <PackageTags>localization;i18n;l10n;translation;strings;resources;markdown;ini</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <!-- agent skill: consumers opt in with <WordsAgentSkill>true</WordsAgentSkill>,
         and the targets file copies SKILL.md into their .claude/skills folder -->
    <None Include="SKILL.md" Pack="true" PackagePath="skills/pattech-words/" />
    <None Include="PatTech.Localization.Core.targets" Pack="true" PackagePath="build/;buildTransitive/" />
    <None Remove="Assets\markdown_constants.json" />
    <EmbeddedResource Include="Assets\markdown_constants.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" makes this a straight join: the analyzer assets flow
         through the Core package to consumers, instead of NuGet's default
         exclude="Build,Analyzers" stripping them from the dependency -->
    <PackageReference Include="PatTech.Localization.Analyzer" Version="[1,)" PrivateAssets="none" />
  </ItemGroup>

</Project>
