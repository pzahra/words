<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <RootNamespace>PatTech.Localization</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- a Release build packs as it builds, for a local feed; a Debug build only builds -->
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
    <PackageId>PatTech.Localization.Core</PackageId>
    <Version>$(ApiVersion)</Version>
    <AssemblyName>PatTech.Localization.Core</AssemblyName>
    <Title>Words</Title>
    <Description>Gives you Words: every user-facing string in a words.ini, looked up by key in the right language — fallbacks, plural forms by Unicode CLDR's rules, {0} and {Name} parameters, {>key} references, a markdown dialect. The engine; pair it with PatTech.Localization.WPF or PatTech.Localization.Avalonia for XAML.</Description>
    <PackageTags>localization;i18n;l10n;translation;strings;resources;markdown;ini;plural;pluralization;cldr</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <!-- rewritten for each ApiVersion: what's new, and what an upgrade should know -->
    <PackageReleaseNotes>1.6.0: enums describe themselves in a template: Format, FormatByName and FormatParams read an enum or IDescribable argument by Describe's letters ({0} its words, {0:T} its tooltip, {0:D} its number), and Words.ToDescribe does the same for string.Format and interpolated strings (string.Create(Words.ToDescribe, $"{brew:T}")); a provider's own ICustomFormatter still sees each argument first, the enum as it is. Describe reads what the app registers on the builder, ConfigureDescribe(d =&gt; d.Fill/FillKey/Keys/Slot), frozen into each dictionary (IWords.DescribeRegistry), so an app keeps its own attributes, keys an enum it does not own, or adds a slot; a subclassed [Description] reads as its base. One pass for every brace: a value is read once (WordsTemplate.Parse), and Words fills its format items itself, so nothing a value says makes Format throw: an item with nothing to read shows #{3}# or #{Name}# (WORDS:FIELD), a format its argument rejects #{0}# (WORDS:FORMAT), a brace that opens nothing shows as written (WORDS:FORMAT), and a name may take an alignment. Fixed: words an IWords of your own answers that select their own forms are cut as circular, and Debug marks a fraction's missing other. Upgrading: an enum in a template printed its member name, and now prints its words, else its [Description], else its name; {0:d} is the description, and Enum's X, F and g are no slot, shown marked #!X# with a WORDS:SLOT warning (pass ToString() for Enum's own text). Describe's D is the number, where it was the description; i and n are retired; U is no longer built in (ConfigureDescribe(d =&gt; d.Slot('U', ".unit")) brings it back); and a value with an obsolete alias reads its first name that is not obsolete. Braces: {{ is one brace, formatted or not, and }} two, in a value or a template handed to FormatByName or PreFormatByName; a constant's words are text, so its {0} shows as written; \\, '' and "" in a value read as written, collapsed once by the file reader where rendering collapsed them again; a reference in a format item ({0:{&gt;fmt}}) and a lone { show as written with a warning, and a number past the arguments or a rejected format show marked, where Format threw; a name no member answers shows #{Name}# where it showed #Name#; and a selector past the arguments picks other, with a warning. FormatByName reads a public field or a property with a public getter and no index. IWords gains DescribeRegistry, with a default: an IWords wrapping another passes the inner one's on.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <!-- agent skill: consumers opt in with <WordsAgentSkill>true</WordsAgentSkill>,
         and the targets file copies SKILL.md into their .claude/skills folder -->
    <None Include="SKILL.md" Pack="true" PackagePath="skills/pattech-words/" />
    <None Include="PatTech.Localization.Core.targets" Pack="true" PackagePath="build/;buildTransitive/" />
    <None Remove="Assets\markdown_constants.json" />
    <EmbeddedResource Include="Assets\markdown_constants.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" makes this a straight join: the analyzer assets flow
         through the Core package to consumers, instead of NuGet's default
         exclude="Build,Analyzers" stripping them from the dependency.
         Pinned by hand, not $(AnalyzerVersion): bumped in a commit of its own once that
         analyzer version is on nuget.org. CI restores only from nuget.org, so pointing
         at an unpublished version breaks every build, the analyzer tag's own gated
         test run included -->
    <PackageReference Include="PatTech.Localization.Analyzer" Version="1.4.0" PrivateAssets="none" />
  </ItemGroup>

</Project>
