<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <VersionPrefix>1.0.0</VersionPrefix>
    <RootNamespace>PatTech.Localization</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>PatTech.Localization.Core</PackageId>
    <Title>Wordsmith Core</Title>
    <Description>Gives you words.</Description>
    <Copyright>2025</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="markdown_constants.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\markdown_constants.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PatTech.Localization.Analyzer" Version="1.0.0" />
  </ItemGroup>

</Project>
