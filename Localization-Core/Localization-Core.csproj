<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <VersionPrefix>1.0.0</VersionPrefix>
    <RootNamespace>PatTech.Localization</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>PatTech.Localization.Core</PackageId>
    <AssemblyName>PatTech.Localization.Core</AssemblyName>
    <Title>Words Core</Title>
    <Description>Gives you words.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>2025</Copyright>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <None Remove="Assets\markdown_constants.json" />
    <EmbeddedResource Include="Assets\markdown_constants.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PatTech.Localization.Analyzer" Version="[1,)" />
  </ItemGroup>

</Project>
