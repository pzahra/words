<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <RootNamespace>PatTech.Localization</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>PatTech.Localization.Core</PackageId>
    <Version>$(ApiVersion)</Version>
    <AssemblyName>PatTech.Localization.Core</AssemblyName>
    <Title>Words</Title>
    <Description>Gives you Words: every user-facing string in a words.ini, looked up by key in the right language — fallbacks, plural forms by Unicode CLDR's rules, {0} and {Name} parameters, {>key} references, a markdown dialect. The engine; pair it with PatTech.Localization.WPF or PatTech.Localization.Avalonia for XAML.</Description>
    <PackageTags>localization;i18n;l10n;translation;strings;resources;markdown;ini;plural;pluralization;cldr</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <!-- rewritten for each ApiVersion: what's new, and what an upgrade should know -->
    <PackageReleaseNotes>1.5.0: plural forms (value#few beside value, picked by Unicode CLDR's rules: Words.Known[key, count], and {0#key} in a template); language codes of up to three parts (zh-Hant-TW), falling back one part at a time, and a Chinese region through the script it writes (zh-TW reads zh-Hant); key names in any script, as Unicode's identifiers have them (UAX #31), in NFC; references and selectors resolve against the key they are written in; under Debug, a count whose form is missing reads its stand-in marked 🎲, and a language with no words of its own brands its first fallback too, which 1.4.0 left plain; TriggerWords, which replaces WordsTickle. Upgrading: a header that is no key name ([a b], [lang.c#]) is now skipped with a WP:NAME warning, and so is an empty [] with every field under it, which 1.4.0 read as the key above's; a file using a three-part code needs 1.5.0, as 1.4.0 drops those fields, and a code outside the grammar is now skipped; a custom IWordsParserConsumer also sees forms, as value#few fields; and a type implementing IWords (or IWordsParserConsumer) beside another interface that declares Language, UICulture, a count indexer (or VisitLine) of its own may no longer compile (CS0229, CS0121): cast to the interface you mean. IWords gains Language and UICulture, with defaults: an IWords of your own that already has a public Language or UICulture now supplies them, recompiled, so check it returns the language its words are in (Language picks the plural rules).</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <!-- agent skill: consumers opt in with <WordsAgentSkill>true</WordsAgentSkill>,
         and the targets file copies SKILL.md into their .claude/skills folder -->
    <None Include="SKILL.md" Pack="true" PackagePath="skills/pattech-words/" />
    <None Include="PatTech.Localization.Core.targets" Pack="true" PackagePath="build/;buildTransitive/" />
    <None Remove="Assets\markdown_constants.json" />
    <EmbeddedResource Include="Assets\markdown_constants.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" makes this a straight join: the analyzer assets flow
         through the Core package to consumers, instead of NuGet's default
         exclude="Build,Analyzers" stripping them from the dependency.
         Pinned by hand, not $(AnalyzerVersion): bumped in a commit of its own once that
         analyzer version is on nuget.org. CI restores only from nuget.org, so pointing
         at an unpublished version breaks every build, the analyzer tag's own gated
         test run included -->
    <PackageReference Include="PatTech.Localization.Analyzer" Version="1.3.0" PrivateAssets="none" />
  </ItemGroup>

</Project>
