<UserControl x:Class="WordsEdit.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ExportViewModel}"
             Padding="10px">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="IsTrue" />
    </UserControl.Resources>
    <StackPanel MinWidth="560" MaxWidth="760">
        <TextBlock FontWeight="Bold" FontSize="16" Margin="2.5px" Text="{Binding Title, Mode=OneWay}"/>
        <TextBlock TextWrapping="Wrap" Margin="2.5px" Opacity="0.7" Text="{l:Words export.blurb}"/>

        <!-- what to write: one loaded file, in one format, at one target -->
        <Grid Margin="2.5px 5px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{l:Words export.file}" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Files}" SelectedItem="{Binding FileNode}" DisplayMemberPath="FullLabel" Margin="0 2.5px"/>

            <TextBlock Grid.Row="1" Text="{l:Words export.format}" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" DisplayMemberPath="Label" Margin="0 2.5px"/>

            <TextBlock Grid.Row="2" Text="{l:Words export.target}" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0 2.5px">
                <Button DockPanel.Dock="Right" Content="{l:Words export.browse}" Command="{Binding BrowseCommand}" Margin="5 0 0 0"/>
                <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>

        <!-- the plan and the loss: said before a byte lands -->
        <StackPanel Visibility="{Binding CanExport, Converter={StaticResource IsTrue}}">
            <TextBlock Text="{Binding Loss}" TextWrapping="Wrap" Margin="2.5px 8px 2.5px 2.5px"/>
            <TextBlock Text="{l:Words export.plan}" FontWeight="SemiBold" Margin="2.5px 8px 2.5px 0"/>
            <ItemsControl ItemsSource="{Binding Plan}" Margin="10 0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0 2">
                            <md:PackIcon Kind="FileOutline" VerticalAlignment="Center" Margin="0 0 4 0"/>
                            <TextBlock Text="{Binding Path}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Words export.exists}" Foreground="DarkOrange" Margin="6 0 0 0" VerticalAlignment="Center"
                                       Visibility="{Binding Exists, Converter={StaticResource IsTrue}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 0 0">
            <Button Content="{l:Words export.export}" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" Width="100" Height="40" Margin="5"/>
            <Button Content="{l:Words dialog.cancel}" Command="{Binding CancelCommand}" Width="100" Height="40" Margin="5"/>
        </StackPanel>
    </StackPanel>
</UserControl>
