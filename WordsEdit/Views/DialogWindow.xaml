<Window x:Class="WordsEdit.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WordsEdit.ViewModels"
        xmlns:v="clr-namespace:WordsEdit.Views"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <!-- the one dialog shell: the view model's type picks its view -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LanguageManagerViewModel}">
            <v:LanguageManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditLanguageViewModel}">
            <v:EditLanguageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyNameViewModel}">
            <v:KeyNameView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TestParametersViewModel}">
            <v:TestParametersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MergeControlViewModel}">
            <v:MergeControlView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView/>
        </DataTemplate>
    </Window.Resources>
    <ContentPresenter Content="{Binding}"/>
</Window>
