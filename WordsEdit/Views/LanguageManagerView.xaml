<UserControl x:Class="WordsEdit.Views.LanguageManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:LanguageManagerViewModel}"
             Padding="10">
    <!-- the Languages window (SPEC: Languages): the working copy's rows at the left, the
         highlighted row's fields at the right, OK and Cancel below -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="IsTrue"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" MinWidth="140">
            <TextBlock Text="{l:Words languages.title}"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="2.5px"/>
            <ListBox ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding Selected}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Margin="2.5px"
                     AllowDrop="True"
                     MaxHeight="300"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.CanContentScroll="False"
                     dd:DragDrop.DragHandler="{Binding LanguageDrag}"
                     dd:DragDrop.DropHandler="{Binding LanguageDrag}"
                     dd:DragDrop.IsDragSource="True"
                     dd:DragDrop.IsDropTarget="True">
                <ListBox.Style>
                    <Style TargetType="ListBox"/>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="4 1">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="LightBlue"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- the code, live as the pane types it and red while the row holds OK back; a
                             mark on the default's language; and the trash -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip="{l:Words languages.remove}"
                                    Style="{StaticResource ToolButton}">
                                <md:PackIcon Kind="Delete"/>
                            </Button>
                            <md:PackIcon DockPanel.Dock="Right"
                                         Kind="Star"
                                         VerticalAlignment="Center"
                                         ToolTip="{l:Words language.default}"
                                         Visibility="{Binding IsDefault, Converter={StaticResource IsTrue}}"/>
                            <TextBlock Text="{Binding Code}"
                                       VerticalAlignment="Center"
                                       Margin="4 0 12 0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Command="{Binding AddCommand}"
                    ToolTip="{l:Words languages.add}"
                    Style="{StaticResource ToolButton}"
                    HorizontalAlignment="Left"
                    Margin="2.5px">
                <md:PackIcon Kind="Plus"/>
            </Button>
        </StackPanel>

        <!-- the pane: the highlighted row's fields, each flagged once it has been typed in; the
             other names are in the default's language, so their header names it -->
        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    Margin="16 0 0 0">
            <HeaderedContentControl Header="{l:Words language.code}"
                                    Margin="2.5px"
                                    FontWeight="SemiBold">
                <TextBox Text="{Binding Selected.Code, UpdateSourceTrigger=PropertyChanged}"
                         FontWeight="Normal"
                         Width="180"/>
            </HeaderedContentControl>
            <HeaderedContentControl Header="{l:Words language.native-name}"
                                    FontWeight="SemiBold"
                                    Margin="2.5px">
                <TextBox Text="{Binding Selected.NativeName, UpdateSourceTrigger=PropertyChanged}"
                         FontWeight="Normal"
                         Width="180"/>
            </HeaderedContentControl>
            <HeaderedContentControl Header="{Binding ExonymHeader}"
                                    FontWeight="SemiBold"
                                    Margin="2.5px">
                <TextBox Text="{Binding Selected.EnglishName, UpdateSourceTrigger=PropertyChanged}"
                         FontWeight="Normal"
                         Width="180"/>
            </HeaderedContentControl>
            <CheckBox IsChecked="{Binding Selected.IsDefault}"
                      Content="{l:Words language.default}"
                      ToolTip="{l:Words language.default-tip}"
                      Margin="2.5px 8px 2.5px 2.5px"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0">
            <Button Content="{l:Words dialog.ok}"
                    Command="{Binding OkCommand}"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="2.5px"/>
            <Button Content="{l:Words dialog.cancel}"
                    Command="{Binding CancelCommand}"
                    MinWidth="80"
                    Margin="2.5px"/>
        </StackPanel>
    </Grid>
</UserControl>
