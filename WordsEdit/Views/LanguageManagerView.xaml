<UserControl x:Class="WordsEdit.Views.LanguageManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="pattech.words"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WordsEdit.ViewModels" 
             xmlns:dd="urn:gong-wpf-dragdrop" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:LanguageManagerViewModel}"
             Padding="10">
    <Grid>
        <StackPanel>
            <TextBlock Text="{l:Words languages.title}"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="2.5px"/>
            <ListBox ItemsSource="{Binding KnownLanguages}"
                     SelectedItem="{Binding SelectedLanguage}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Margin="2.5px"
                     AllowDrop="True"
                     MaxHeight="200px"
                     ScrollViewer.CanContentScroll="false"
                     dd:DragDrop.DragHandler="{Binding LanguageDrag}"
                     dd:DragDrop.DropHandler="{Binding LanguageDrag}"
                     dd:DragDrop.IsDragSource="True"
                     dd:DragDrop.IsDropTarget="True">
                <ListBox.Style>
                    <Style TargetType="ListBox"/>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            Padding="4">
                                        <TextBlock HorizontalAlignment="Center"><Run Text="{Binding Code}"/> , <Run Text="{Binding NativeName}"/></TextBlock>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="LightBlue"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <Button Content="{l:Words languages.add}"
                    Command="{Binding AddLanguageCommand}"
                    Margin="2.5px"/>
            <Button Content="{l:Words languages.edit}"
                    Command="{Binding EditLanguageCommand}"
                    Margin="2.5px"/>
            <Button Content="{l:Words languages.remove}"
                    Command="{Binding RemoveLanguageCommand}"
                    Margin="2.5px"/>
            <Button Content="{l:Words dialog.ok}"
                    Command="{Binding OkayCommand}"
                    Margin="2.5px"/>
        </StackPanel>
    </Grid>
</UserControl>
