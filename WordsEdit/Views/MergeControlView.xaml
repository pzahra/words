<UserControl x:Class="WordsEdit.Views.MergeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:MergeControlViewModel}"
             MinWidth="700"
             Padding="10">
    <!-- the Merge window (SPEC: Merge): the files taking part at the left, each with the languages it
         supplies; every loaded file at the right, ticked to take part; the split the other way below -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="IsTrue"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding Title, Mode=OneWay}"
                   FontWeight="Bold"
                   FontSize="16"
                   Margin="2.5px"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0 0 10 0">
                <TextBlock Text="{l:Words merge.files}" FontWeight="SemiBold" Margin="2.5px"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="150" MaxHeight="350">
                    <ItemsControl ItemsSource="{Binding Selected}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2.5px 2.5px 2.5px 8px">
                                    <DockPanel>
                                        <RadioButton Content="{l:Words merge.base}"
                                                     GroupName="BaseFileGroup"
                                                     IsChecked="{Binding IsBase}"
                                                     DockPanel.Dock="Right"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Expander Header="{l:Words merge.languages}" IsExpanded="False">
                                        <ItemsControl ItemsSource="{Binding Languages}" Margin="30 0 0 0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="0 2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10 0 0 0">
                <TextBlock Text="{l:Words merge.available}" FontWeight="SemiBold" Margin="2.5px"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                    <ItemsControl ItemsSource="{Binding Files}" Margin="2.5px">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0 2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- the ticked files do not share their keys -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="200"
                              Visibility="{Binding HasConflict, Converter={StaticResource IsTrue}}">
                    <TextBlock Text="{Binding ConflictMessage}"
                               Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                               TextWrapping="Wrap"
                               Margin="2.5px"/>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <!-- the other direction: one language of one file, written on its own for a translator -->
        <TextBlock Text="{l:Words merge.split}" FontWeight="SemiBold" Margin="2.5px 10px 2.5px 2.5px"/>
        <DockPanel Margin="2.5px" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    Content="{l:Words merge.split-button}"
                    Command="{Binding SplitCommand}"
                    ToolTip="{l:Words merge.split-tip}"
                    MinWidth="80"
                    Margin="10 0 0 0"/>
            <TextBlock Text="{l:Words merge.file}" VerticalAlignment="Center" Margin="0 0 5 0"/>
            <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SplitFile}" DisplayMemberPath="Label" MinWidth="160" Margin="0 0 10 0"/>
            <TextBlock Text="{l:Words merge.language}" VerticalAlignment="Center" Margin="0 0 5 0"/>
            <ComboBox ItemsSource="{Binding SplitLanguages}" SelectedItem="{Binding SplitLanguage}" DisplayMemberPath="DisplayName" MinWidth="160"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="{l:Words merge.merge}"
                    Command="{Binding MergeCommand}"
                    IsEnabled="{Binding CanMerge}"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="2.5px"/>
            <Button Content="{l:Words dialog.cancel}"
                    Command="{Binding CancelCommand}"
                    MinWidth="80"
                    Margin="2.5px"/>
        </StackPanel>
    </StackPanel>
</UserControl>
