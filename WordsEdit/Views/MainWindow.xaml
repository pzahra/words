<Window x:Class="WordsEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="https://github.com/pzahra/words"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:WordsEdit.ViewModels" 
        xmlns:uc="clr-namespace:WordsEdit.Utils"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dd="urn:gong-wpf-dragdrop" 
        mc:Ignorable="d"
		d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="{Binding TitleMarked}"
        FontFamily="Montserrat"
		Height="640" Width="1080"
        MinHeight="450" MinWidth="800"
        Closing="MainWindow_Closing">

    <Window.CommandBindings>
        <!-- Find carries Ctrl+F of its own; focusing a box is the view's business -->
        <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch"/>
    </Window.CommandBindings>

    <Window.Resources>
		<md:EqualityToVisibilityConverter x:Key="Equals" />
		<md:NullableToVisibilityConverter x:Key="IsNotNull" />
		<md:BooleanToVisibilityConverter x:Key="IsFalse" TrueValue="Collapsed" FalseValue="Visible" />
        <uc:GenericValueConverter x:Key="IsFalseAndNotNull" Else="Collapsed">
            <uc:ConverterCondition When="{StaticResource False}" Then="Visible"/>
        </uc:GenericValueConverter>
		<uc:GenericValueConverter x:Key="BooleanToBoldConverter" Else="SemiBold">
			<uc:ConverterCondition When="{StaticResource True}" Then="ExtraBlack" />
		</uc:GenericValueConverter>
        <l:WordsConverter x:Key="WordsConverter" />
        <!-- the translator's answer under a parameter (SPEC: Parameters → The inputs): a box, or an enum's
             members to pick from; the error brush and the complaint when the type cannot read it -->
        <DataTemplate x:Key="ParameterInput" DataType="{x:Type vm:ParameterRow}">
            <Border CornerRadius="3"
                    BorderThickness="1"
                    Margin="30px 0 0 2.5px"
                    ToolTip="{Binding InputError}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InputError}" Value="{x:Null}">
                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignBody}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="2.5px">
                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="{l:Words parameters.input}"
                             Visibility="{Binding IsEnum, Converter={StaticResource IsFalse}}"/>
                    <ComboBox ItemsSource="{Binding Members}"
                              SelectedItem="{Binding Input}"
                              md:HintAssist.Hint="{l:Words parameters.input}"
                              Visibility="{Binding IsEnum, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- a box that says what is wrong with what it holds -->
        <Style x:Key="CheckedBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ToolTip, RelativeSource={RelativeSource Self}, Converter={StaticResource IsNotNull}}" Value="Visible">
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- the menu is the inventory (SPEC: Menu and toolbars): every command, from the table -->
        <Menu DockPanel.Dock="Top" ItemsSource="{Binding Commands.Menu}" UsesItemContainerTemplate="True" ItemContainerTemplateSelector="{StaticResource MenuRowSelector}"/>
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".8*"/>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

			<md:ColorZone Mode="PrimaryLight" Grid.Row="0" Grid.ColumnSpan="3" VerticalAlignment="Stretch" />

			<Grid   Grid.Column="0"
                    Grid.Row="0"
                    Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                    Margin="3 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back and Forward by the search (SPEC: Navigation): both move through the document -->
                <ToolBar Grid.Column="0"
                         ItemsSource="{Binding Commands.NavigationTools}"
                         ToolBarTray.IsLocked="True"
                         Background="Transparent"
                         VerticalAlignment="Center"/>
                <md:PackIcon Grid.Column="1"
                             Kind="Magnify"
                             Height="20"
                             Width="20"
                             VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox"
                         Text="{Binding Tree.SearchFilterText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="{l:Words main.search-hint}"
                         Grid.Column="2"
                         VerticalAlignment="Center"
                         Margin="2.5px"/>
                <!-- the filters (SPEC: Filters): a vertical toolbar from the table, in a popup whose button wears the hidden count -->
                <md:Badged Grid.Column="3" BadgeColorZoneMode="SecondaryMid" VerticalAlignment="Center">
                    <md:Badged.Style>
                        <Style TargetType="md:Badged" BasedOn="{StaticResource {x:Type md:Badged}}">
                            <Setter Property="Badge" Value="{Binding Tree.HiddenCount}"/>
                            <Style.Triggers>
                                <!-- nothing hidden, no badge; a DataTrigger compares the count as a number -->
                                <DataTrigger Binding="{Binding Tree.HiddenCount}" Value="0">
                                    <Setter Property="Badge" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </md:Badged.Style>
                    <Grid>
                        <!-- a toolbar toggle opens a plain popup; it closes on a click anywhere else, and
                             PopupToggle keeps the click that closed it from reopening it -->
                        <ToggleButton x:Name="FilterToggle"
                                      Style="{StaticResource ToolToggle}"
                                      IsChecked="{Binding IsOpen, ElementName=FilterPopup, Mode=TwoWay}"
                                      ToolTip="{l:Words main.filters}"
                                      uc:PopupToggle.Popup="{Binding ElementName=FilterPopup}">
                            <md:PackIcon Kind="FilterVariant"/>
                        </ToggleButton>
                        <Popup x:Name="FilterPopup"
                               PlacementTarget="{Binding ElementName=FilterToggle}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <md:Card Padding="2" Margin="6" UniformCornerRadius="3" md:ElevationAssist.Elevation="Dp4">
                                <ToolBarTray Orientation="Vertical" IsLocked="True" Background="Transparent">
                                    <ToolBar ItemsSource="{Binding Commands.FilterTools}" Background="Transparent"/>
                                </ToolBarTray>
                            </md:Card>
                        </Popup>
                    </Grid>
                </md:Badged>
            </Grid>
            <Grid Grid.Column="0" 
                  Grid.Row="1" 
                  Grid.RowSpan="2" 
                  Margin="3 0">
                <Border CornerRadius="3" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}">
                    <TreeView ItemsSource="{Binding Tree.KeyNodes}"
					          SelectedItemChanged="TreeView_OnSelectedItemChanged"
                              PreviewMouseRightButtonDown="TreeView_OnPreviewMouseRightButtonDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AllowDrop="True"
                              dd:DragDrop.DragHandler="{Binding KeyDrag}"
                              dd:DragDrop.DropHandler="{Binding KeyDrag}"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True">
                        <TreeView.ContextMenu>
                            <!-- the Edit menu again, on the row that was right-clicked; each command says whether it applies -->
                            <ContextMenu ItemsSource="{Binding Commands.EditRows}" UsesItemContainerTemplate="True" ItemContainerTemplateSelector="{StaticResource MenuRowSelector}"/>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" 
                                   BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                <Setter Property="IsExpanded" 
                                        Value="{Binding IsExpanded}"/>
                                <Setter Property="IsSelected" 
                                        Value="{Binding IsSelected}"/>
                                <Setter Property="Visibility" 
                                        Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:KeyNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="File"
                                                 Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="Bookshelf"
                                                 ToolTip="{l:Words main.library-file}"
                                                 Visibility="{Binding IsLibraryFile, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <!-- a library lacking what a host lists: an app offering it reads the library's default -->
                                    <md:PackIcon Kind="BookAlertOutline"
                                                 Foreground="{StaticResource WordsmithOrangeBrush}"
                                                 ToolTip="{Binding LacksLanguages}"
                                                 Visibility="{Binding HasLacks, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Command="{Binding DataContext.ShowFileGripesCommand, RelativeSource={uc:FindAncestor TreeView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding GripeCount, Converter={StaticResource NotZeroToVisibilityConverter}}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{StaticResource WordsmithOrangeBrush}"
                                            Padding="2 0"
                                            Height="20"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            ToolTip="{l:Words main.file-gripes}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding GripeCount}" FontSize="11" VerticalAlignment="Center" Margin="2 0 0 0"/>
                                        </StackPanel>
                                    </Button>
                                    <md:PackIcon Kind="TranslateOff" 
                                                 Visibility="{Binding IsConstant, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="HandFrontLeft" 
                                                 Foreground="{StaticResource WordsmithBlueBrush}"
                                                 Visibility="{Binding NeedsReview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="ClockAlert" 
                                                 Foreground="{StaticResource WordsmithBlueBrush}"
                                                 Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="Eraser" 
                                                 Visibility="{Binding IsOverwritten, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="{Binding EmptyValue, Converter={StaticResource BooleanToBoldConverter}}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:OrganizerNode}">
                                <DockPanel Opacity="0.7" LastChildFill="True">
                                    <md:PackIcon Kind="CommentTextOutline" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Caption}"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center"
                                               Margin="4 0 0 0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Caption}"/>
                                </DockPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Border>
            </Grid>
            <!-- the selected node's name, Rename at its right (SPEC: Menu and toolbars) -->
            <DockPanel Grid.Column="1" Grid.Row="0" Margin="3 0">
                <ToolBar DockPanel.Dock="Right"
                         ItemsSource="{Binding Commands.NameTools}"
                         ToolBarTray.IsLocked="True"
                         Background="Transparent"
                         Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"/>
                <TextBlock Margin="2.5px"
                           FontWeight="SemiBold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Tree.SelectedKeyNode.Path, Mode=OneWay}"
                           ToolTip="{Binding Tree.SelectedKeyNode.Path}"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="3 0">
                <StackPanel>
                <!-- the editing boxes keep no undo of their own: Ctrl+Z in any of them is the document's (SPEC: Undo) -->
                <StackPanel Visibility="{Binding Tree.SelectedKey, Converter={StaticResource IsNotNull}}">
                    <TextBlock TextWrapping="Wrap"
                               Margin="2.5px"
                               Text="{l:Words main.context}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="0 0 30px 2.5px" 
                            BorderBrush="{DynamicResource PrimaryHueLightBrush}">
                        <uc:WordsBox x:Name="KeyContextBox"
                                     History="{Binding TextHistory}"
                                     Text="{Binding Tree.SelectedKey.Context, UpdateSourceTrigger=PropertyChanged}"
                                     uc:Spelling.Language="{Binding Tree.DefaultLanguage}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     uc:Spelling.WhenEditing="True"
                                     TextAlignment="Left"
                                     Margin="2.5px"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               Margin="2.5px"
                               Text="{l:Words main.translator-comment}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="30px 0 0 2.5px" 
                            BorderBrush="{DynamicResource MaterialDesignBody}">
                        <uc:WordsBox x:Name="KeyCommentBox"
                                     History="{Binding TextHistory}"
                                     Text="{Binding Tree.SelectedKey.Comment, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     uc:Spelling.WhenEditing="True"
                                     TextAlignment="Left"
                                     Margin="2.5px"/>
                    </Border>
                    <!-- the parameters carry the conversation on (SPEC: Parameters → In the pane): each definition the
                         programmer's message, the translator's input under it; then what the default uses and nobody
                         defined, faint, each with its input; the + last, where the next pair would go -->
                    <StackPanel Visibility="{Binding ParametersPane.IsShown, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock TextWrapping="Wrap"
                                   Margin="2.5px"
                                   Text="{l:Words parameters.heading}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Visibility="{Binding ParametersPane.HasThread, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl x:Name="DefinitionsList" ItemsSource="{Binding ParametersPane.Definitions}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DefinitionRow}">
                                    <StackPanel>
                                        <Border CornerRadius="3"
                                                BorderThickness="1"
                                                Margin="0 0 30px 2.5px"
                                                BorderBrush="{DynamicResource PrimaryHueLightBrush}">
                                            <StackPanel Margin="2.5px">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{Binding RemoveCommand}"
                                                            ToolTip="{l:Words parameters.remove}"
                                                            Style="{StaticResource ToolButton}"
                                                            VerticalAlignment="Center">
                                                        <md:PackIcon Kind="Delete"/>
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- the placeholder, renamed as it is written; dimmed where the default does not use it -->
                                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding UnusedTip}">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{}{" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding NameText}"
                                                                     ToolTip="{Binding NameError}"
                                                                     Style="{StaticResource CheckedBox}"
                                                                     FontFamily="Consolas"
                                                                     MinWidth="24"
                                                                     VerticalAlignment="Center"/>
                                                            <TextBlock Text="}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <ComboBox ItemsSource="{x:Static vm:DefinitionRow.TypeNames}"
                                                                  SelectedItem="{Binding TypeName}"
                                                                  ToolTip="{l:Words parameters.type}"
                                                                  MinWidth="70"
                                                                  Margin="10 0 0 0"
                                                                  VerticalAlignment="Center"/>
                                                        <TextBox Text="{Binding PrefixText}"
                                                                 ToolTip="{Binding PrefixError}"
                                                                 Style="{StaticResource CheckedBox}"
                                                                 md:HintAssist.Hint="{l:Words parameters.prefix}"
                                                                 Visibility="{Binding IsEnumPicked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                 MinWidth="120"
                                                                 Margin="6 0 0 0"
                                                                 VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <uc:WordsBox x:Name="DescriptionBox"
                                                             History="{Binding History}"
                                                             Text="{Binding Parameter.Description, UpdateSourceTrigger=PropertyChanged}"
                                                             uc:Spelling.Language="{Binding Language}"
                                                             uc:Spelling.WhenEditing="True"
                                                             md:HintAssist.Hint="{l:Words parameters.description}"
                                                             TextWrapping="Wrap"
                                                             TextAlignment="Left"
                                                             Margin="0 2.5px 0 0"/>
                                            </StackPanel>
                                        </Border>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ParameterInput}" Focusable="False"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding ParametersPane.Found}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FoundRow}">
                                    <StackPanel>
                                        <Button Command="{Binding AdoptCommand}"
                                                ToolTip="{Binding AdoptTip}"
                                                Style="{StaticResource ToolButton}"
                                                HorizontalAlignment="Left"
                                                Opacity="0.55"
                                                Margin="2.5px">
                                            <TextBlock FontFamily="Consolas" Text="{Binding Placeholder, Mode=OneWay, StringFormat='+ {0}'}"/>
                                        </Button>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ParameterInput}" Focusable="False"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding ParametersPane.AddCommand}"
                                ToolTip="{l:Words parameters.add}"
                                Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left"
                                Margin="2.5px">
                            <md:PackIcon Kind="Plus"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding Tree.SelectedOrganizer, Converter={StaticResource IsNotNull}}">
                    <TextBlock TextWrapping="Wrap"
                               Margin="2.5px"
                               Text="{l:Words main.freeform-comment}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3"
                            BorderThickness="1"
                            Margin="0 0 30px 2.5px"
                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                        <uc:WordsBox x:Name="CommentTextBox"
                                     History="{Binding TextHistory}"
                                     Text="{Binding Tree.SelectedOrganizer.Text, UpdateSourceTrigger=PropertyChanged}"
                                     uc:Spelling.Language="{Binding Tree.DefaultLanguage}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     uc:Spelling.WhenEditing="True"
                                     TextAlignment="Left"
                                     MinHeight="80"
                                     Margin="2.5px"/>
                    </Border>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1"
                  Grid.Row="2"
                  Visibility="{Binding Tree.SelectedKey, Converter={StaticResource IsNotNull}}"
                  Margin="3 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

				<md:ColorZone Mode="PrimaryLight" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Stretch" />

				<TextBlock Text="{Binding Tree.DefaultTitle}"
                           ToolTip="{l:Words main.default-tip}"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="2.5px"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <StackPanel Orientation="Horizontal" 
                            Grid.Row="0" 
                            Grid.Column="1" 
                            VerticalAlignment="Center">
                    <md:Badged Badge="{Binding DefaultPreview.GripeCount}"
                               BadgeColorZoneMode="SecondaryMid"
                               Visibility="{Binding DefaultPreview.GripeCount, Converter={StaticResource NotZeroToVisibilityConverter}}"
                               VerticalAlignment="Center">
                        <Button Command="{Binding ShowGripesCommand}"
                                CommandParameter="{Binding DefaultPreview}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                ToolTip="{l:Words main.preview-gripes}"
                                Foreground="{StaticResource WordsmithOrangeBrush}"
                                Content="{md:PackIcon Kind=AlertCircleOutline, Size=24}"
                                Padding="4 0"
                                Margin="2.5px" />
                    </md:Badged>
                    <!-- the header's commands, from the table (SPEC: Menu and toolbars): the form, the key's
                         flags, the eye; unclipped, so the form's badge shows above its button -->
                    <ToolBar ItemsSource="{Binding Commands.DefaultTools}"
                             ToolBarTray.IsLocked="True"
                             ClipToBounds="False"
                             Background="Transparent"/>
                </StackPanel>
                <Border CornerRadius="3" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource PrimaryHueDarkBrush}" 
                        Grid.Row="1" 
                        Grid.Column="0" 
                        Grid.ColumnSpan="2">
                    <Grid>
                        <uc:WordsBox x:Name="DefaultValueBox"
                                     History="{Binding TextHistory}"
                                     Text="{Binding Tree.DefaultText, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="{Binding Tree.DefaultFormHint}"
                                     uc:Spelling.Language="{Binding Tree.DefaultLanguage}"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     TextAlignment="Left"
                                     uc:Spelling.WhenEditing="True"
                                     Visibility="{Binding ShowDefaultPreview, Converter={StaticResource IsFalse}}"
                                     Margin="2.5px"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowDefaultPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="3.5 7 0 0">
                                <TextBlock uc:MarkdownPreview.Text="{Binding DefaultPreview.Text}"
                                           uc:MarkdownPreview.Settings="{Binding DefaultPreview.Settings}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <!-- the languages (SPEC: the translation pane): the manager, and the one selected as a combo box, from the
                 table; beside them the light that comes on when this system has no spell checker for the language -->
            <StackPanel Grid.Column="2"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}">
                <ToolBar ItemsSource="{Binding Commands.LanguageTools}"
                         ToolBarTray.IsLocked="True"
                         Background="Transparent"
                         Margin="3 0"/>
                <md:PackIcon Kind="Spellcheck"
                             Foreground="{StaticResource WordsmithOrangeBrush}"
                             ToolTip="{Binding SpellCheckerNote}"
                             Visibility="{Binding SpellCheckerMissing, Converter={StaticResource BooleanToVisibilityConverter}}"
                             VerticalAlignment="Center"
                             Width="20"
                             Height="20"
                             Margin="2 0"/>
            </StackPanel>
            <ScrollViewer Grid.Column="2"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Tree.SelectedEntry, Converter={StaticResource IsNotNull}}"
                          Margin="3 0">
                <StackPanel>
                    <TextBlock Text="{l:Words main.translation-context}"
                               Margin="2.5px"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="0 0 30px 2.5px" 
                            BorderBrush="{DynamicResource PrimaryHueLightBrush}">
                        <uc:WordsBox x:Name="EntryContextBox"
                                     History="{Binding TextHistory}"
                                     Text="{Binding Tree.SelectedEntry.Context, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     TextAlignment="Left"
                                     AcceptsReturn="True"
                                     uc:Spelling.WhenEditing="True"
                                     uc:Spelling.Language="{Binding Tree.SelectedLanguage.Code}"
                                     Margin="2.5px"/>
                    </Border>
                    <TextBlock Text="{l:Words main.translation-comment}"
                               HorizontalAlignment="Right"
                               Margin="2.5px"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="30px 0 0 2.5px" 
                            BorderBrush="{DynamicResource MaterialDesignBody}">
                        <uc:WordsBox x:Name="EntryCommentBox"
                                     History="{Binding TextHistory}"
                                     Text="{Binding Tree.SelectedEntry.Comment, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     TextAlignment="Left"
                                     AcceptsReturn="True"
                                     uc:Spelling.WhenEditing="True"
                                     uc:Spelling.Language="{Binding Tree.SelectedLanguage.Code}"
                                     Margin="2.5px"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2"
                  Grid.Row="2"
                  Visibility="{Binding Tree.SelectedEntry, Converter={StaticResource IsNotNull}}"
                  Margin="3 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

				<md:ColorZone Mode="PrimaryLight" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Stretch" />
				
				<StackPanel Grid.Row="0" 
                            Grid.Column="0"  
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tree.TranslationTitle}"
                               Margin="2.5px 0"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Label ToolTip="{l:Words main.stale-tip}"
						    Visibility="{Binding Tree.SelectedEntry.Stale, Converter={StaticResource IsNotNull}}">
                        <TextBlock Margin="4 -1">
                            <Run Text="{l:Words main.stale}" />
                            <Run Text="{Binding Tree.SelectedEntry.Stale, Mode=OneWay}" />
                        </TextBlock>
                    </Label>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Grid.Row="0"
                            Grid.Column="1">
                <md:Badged Badge="{Binding TranslationPreview.GripeCount}"
                           BadgeColorZoneMode="SecondaryMid"
                           Visibility="{Binding TranslationPreview.GripeCount, Converter={StaticResource NotZeroToVisibilityConverter}}"
                           VerticalAlignment="Center">
                    <Button Command="{Binding ShowGripesCommand}"
                            CommandParameter="{Binding TranslationPreview}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="{l:Words main.preview-gripes}"
                            Foreground="{StaticResource WordsmithOrangeBrush}"
                            Content="{md:PackIcon Kind=AlertCircleOutline, Size=24}"
                            Padding="4 0"
                            Margin="2.5px" />
                </md:Badged>
                    <!-- the form, the stale flag in the selected language, the eye -->
                    <ToolBar ItemsSource="{Binding Commands.TranslationTools}"
                             ToolBarTray.IsLocked="True"
                             ClipToBounds="False"
                             Background="Transparent"/>
                </StackPanel>
                <Border CornerRadius="3" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource PrimaryHueDarkBrush}" 
                        Grid.Row="1"
                        Grid.Column="0" 
                        Grid.ColumnSpan="2">
                    <Grid>
                        <uc:WordsBox x:Name="EntryValueBox"
                                     History="{Binding TextHistory}"
                                     Text="{Binding Tree.EntryText, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="{Binding Tree.EntryHint}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     TextAlignment="Left"
                                     uc:Spelling.WhenEditing="True"
                                     uc:Spelling.Language="{Binding Tree.SelectedLanguage.Code}"
                                     Visibility="{Binding ShowLocalizationPreview, Converter={StaticResource IsFalse}}"
                                     Margin="2.5px"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowLocalizationPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="3.5 7 0 0">
                                <TextBlock uc:MarkdownPreview.Text="{Binding TranslationPreview.Text}"
                                           uc:MarkdownPreview.Settings="{Binding TranslationPreview.Settings}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

			<md:ColorZone Mode="PrimaryLight" Grid.Row="3" Grid.ColumnSpan="3" VerticalAlignment="Stretch" />
			
            <!-- the toolbars (SPEC: Menu and toolbars): what is convenient, drawn from the command table; the menu has the rest -->
            <ToolBar Grid.Column="0"
                     Grid.Row="3"
                     ItemsSource="{Binding Commands.NodeTools}"
                     ToolBarTray.IsLocked="True"
                     Background="Transparent"
                     VerticalAlignment="Bottom"/>
            <ToolBar Grid.Column="1"
                     Grid.Row="3"
                     ItemsSource="{Binding Commands.KeyTools}"
                     ToolBarTray.IsLocked="True"
                     Background="Transparent"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"/>
        </Grid>
    </DockPanel>
</Window>
