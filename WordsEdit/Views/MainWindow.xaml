<Window x:Class="WordsEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="https://github.com/pzahra/words"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:WordsEdit.ViewModels" 
        xmlns:uc="clr-namespace:WordsEdit.Utils"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dd="urn:gong-wpf-dragdrop" 
        mc:Ignorable="d"
		d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="{Binding TitleMarked}"
        FontFamily="Montserrat"
		Height="640" Width="960"
        MinHeight="450" MinWidth="800"
        Closing="MainWindow_Closing">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding LoadFileCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding StaleAllLanguagesCommand}"/>
        <KeyBinding Key="F2" Command="{Binding RenameNodeCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveNodeCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <!-- Find carries Ctrl+F of its own; focusing a box is the view's business -->
        <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch"/>
    </Window.CommandBindings>

    <Window.Resources>
		<md:EqualityToVisibilityConverter x:Key="Equals" />
		<md:NullableToVisibilityConverter x:Key="IsNotNull" />
		<md:BooleanToVisibilityConverter x:Key="IsFalse" TrueValue="Collapsed" FalseValue="Visible" />
        <uc:GenericValueConverter x:Key="IsFalseAndNotNull" Else="Collapsed">
            <uc:ConverterCondition When="{StaticResource False}" Then="Visible"/>
        </uc:GenericValueConverter>
		<uc:GenericValueConverter x:Key="BooleanToBoldConverter" Else="SemiBold">
			<uc:ConverterCondition When="{StaticResource True}" Then="ExtraBlack" />
		</uc:GenericValueConverter>
	</Window.Resources>

    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".8*"/>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

			<md:ColorZone Mode="PrimaryLight" Grid.Row="0" Grid.ColumnSpan="3" VerticalAlignment="Stretch" />

			<Grid   Grid.Column="0"
                    Grid.Row="0"
                    Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                    Margin="3 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <md:PackIcon Grid.Column="0" 
                             Kind="Magnify" 
                             Height="20"
                             Width="20"
                             VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox"
                         Text="{Binding Tree.SearchFilterText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="{l:Words main.search-hint}"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         Margin="2.5px"/>
                <DockPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tree.HiddenText}"
                               Visibility="{Binding Tree.IsFiltering, Converter={StaticResource BooleanToVisibilityConverter}}"
                               VerticalAlignment="Center"
                               Opacity="0.7"
                               Margin="2.5px"/>
                    <Button Command="{Binding ClearFiltersCommand}"
                            Visibility="{Binding Tree.IsFiltering, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="{l:Words main.clear-filters}"
                            Padding="4 0"
                            MinWidth="0"
                            Margin="2.5px">
                        <md:PackIcon Kind="FilterRemoveOutline" Width="22" Height="22"/>
                    </Button>
                    <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=ClockAlert,Size=25}"
                                  ToolTip="{l:Words main.stale-view}"
                                  IsChecked="{Binding Tree.IsStaleFilter}" 
                                  Margin="2.5px"/>
                    <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=HandFrontLeft,Size=25}"
                                  ToolTip="{l:Words main.review-view}"
                                  IsChecked="{Binding Tree.NeedsReviewFilter}"
                                  Margin="2.5px"/>
                    <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=TextBoxRemoveOutline,Size=25}"
                                  ToolTip="{l:Words main.missing-view}"
                                  IsChecked="{Binding Tree.MissingFilter}"
                                  Margin="2.5px"/>
                </DockPanel>
            </Grid>
            <Grid Grid.Column="0" 
                  Grid.Row="1" 
                  Grid.RowSpan="2" 
                  Margin="3 0">
                <Border CornerRadius="3" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}">
                    <TreeView ItemsSource="{Binding Tree.KeyNodes}"
					          SelectedItemChanged="TreeView_OnSelectedItemChanged"
                              PreviewMouseRightButtonDown="TreeView_OnPreviewMouseRightButtonDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AllowDrop="True"
                              dd:DragDrop.DragHandler="{Binding KeyDrag}"
                              dd:DragDrop.DropHandler="{Binding KeyDrag}"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True">
                        <TreeView.ContextMenu>
                            <!-- the structure edits, on the row that was right-clicked; each command says whether it applies -->
                            <ContextMenu>
                                <MenuItem Header="{l:Words menu.add-node}" Command="{Binding AddNodeCommand}" Icon="{md:PackIcon Kind=PlusThick}"/>
                                <MenuItem Header="{l:Words menu.add-key}" Command="{Binding AddKeyCommand}" Icon="{md:PackIcon Kind=KeyPlus}"/>
                                <MenuItem Header="{l:Words menu.add-comment}" Command="{Binding AddOrganizerCommand}" Icon="{md:PackIcon Kind=CommentPlus}"/>
                                <MenuItem Header="{l:Words menu.rename}" InputGestureText="F2" Command="{Binding RenameNodeCommand}" Icon="{md:PackIcon Kind=RenameBox}"/>
                                <MenuItem Header="{l:Words menu.remove}" InputGestureText="Del" Command="{Binding RemoveNodeCommand}" Icon="{md:PackIcon Kind=Delete}"/>
                                <Separator/>
                                <MenuItem Header="{l:Words menu.toggle-review}" Command="{Binding ToggleNeedsReviewCommand}" Icon="{md:PackIcon Kind=HandFrontLeft}"/>
                                <MenuItem Header="{l:Words menu.toggle-constant}" Command="{Binding ToggleConstantCommand}" Icon="{md:PackIcon Kind=TranslateOff}"/>
                                <MenuItem Header="{l:Words menu.stale-all}" InputGestureText="Ctrl+Shift+S" Command="{Binding StaleAllLanguagesCommand}" Icon="{md:PackIcon Kind=ClockAlert}"/>
                                <MenuItem Header="{l:Words menu.remove-key}" Command="{Binding RemoveKeyCommand}" Icon="{md:PackIcon Kind=KeyRemove}"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" 
                                   BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                <Setter Property="IsExpanded" 
                                        Value="{Binding IsExpanded}"/>
                                <Setter Property="IsSelected" 
                                        Value="{Binding IsSelected}"/>
                                <Setter Property="Visibility" 
                                        Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:KeyNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="File"
                                                 Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="Bookshelf"
                                                 ToolTip="{l:Words main.library-file}"
                                                 Visibility="{Binding IsLibraryFile, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Command="{Binding DataContext.ShowFileGripesCommand, RelativeSource={uc:FindAncestor TreeView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding GripeCount, Converter={StaticResource NotZeroToVisibilityConverter}}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="DarkOrange"
                                            Padding="2 0"
                                            Height="20"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            ToolTip="{l:Words main.file-gripes}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding GripeCount}" FontSize="11" VerticalAlignment="Center" Margin="2 0 0 0"/>
                                        </StackPanel>
                                    </Button>
                                    <md:PackIcon Kind="TranslateOff" 
                                                 Visibility="{Binding IsConstant, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="HandFrontLeft" 
                                                 Foreground="Blue"
                                                 Visibility="{Binding NeedsReview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="ClockAlert" 
                                                 Foreground="Blue"
                                                 Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="Eraser" 
                                                 Visibility="{Binding IsOverwritten, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="{Binding EmptyValue, Converter={StaticResource BooleanToBoldConverter}}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:OrganizerNode}">
                                <DockPanel Opacity="0.7" LastChildFill="True">
                                    <md:PackIcon Kind="CommentTextOutline" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Caption}"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center"
                                               Margin="4 0 0 0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Caption}"/>
                                </DockPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" 
                        Grid.Column="1"
                        Grid.Row="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center">
				<TextBlock Margin="2.5px"
                           FontWeight="SemiBold"
                           FontSize="18"
						   Text="{Binding Tree.SelectedKeyNode.Path, Mode=OneWay}"
						   ToolTip="{Binding Tree.SelectedKeyNode.Path}"/>
				<Button Padding="0 0 1 0" 
                        Margin="2 0 0 0" 
                        Height="16" 
                        Command="{Binding RenameNodeCommand}" 
                        Visibility="{Binding Tree.SelectedKeyNode.IsFile, Converter={StaticResource IsFalseAndNotNull},FallbackValue=Collapsed}"
                        ToolTip="{l:Words main.edit-name}">
                    <md:PackIcon Kind="RenameBox"/>
                </Button>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="3 0">
                <StackPanel>
                <StackPanel Visibility="{Binding Tree.SelectedKey, Converter={StaticResource IsNotNull}}">
                    <TextBlock TextWrapping="Wrap"
                               Margin="2.5px"
                               Text="{l:Words main.context}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="0 0 30px 2.5px" 
                            BorderBrush="Green">
                        <TextBox Text="{Binding Tree.SelectedKey.Context, UpdateSourceTrigger=PropertyChanged}" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 TextAlignment="Left"
                                 Margin="2.5px"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               Margin="2.5px"
                               Text="{l:Words main.translator-comment}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="30px 0 0 2.5px" 
                            BorderBrush="Black">
                        <TextBox Text="{Binding Tree.SelectedKey.Comment, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 TextAlignment="Left"
                                 Margin="2.5px"/>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding Tree.SelectedOrganizer, Converter={StaticResource IsNotNull}}">
                    <TextBlock TextWrapping="Wrap"
                               Margin="2.5px"
                               Text="{l:Words main.freeform-comment}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3"
                            BorderThickness="1"
                            Margin="0 0 30px 2.5px"
                            BorderBrush="Gray">
                        <TextBox Text="{Binding Tree.SelectedOrganizer.Text, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 TextAlignment="Left"
                                 MinHeight="80"
                                 Margin="2.5px"/>
                    </Border>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1"
                  Grid.Row="2"
                  Visibility="{Binding Tree.SelectedKey, Converter={StaticResource IsNotNull}}"
                  Margin="3 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

				<md:ColorZone Mode="PrimaryLight" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Stretch" />

				<TextBlock Text="{l:Words main.default}"
                           ToolTip="{l:Words main.default-tip}"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="2.5px"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <StackPanel Orientation="Horizontal" 
                            Grid.Row="0" 
                            Grid.Column="1" 
                            VerticalAlignment="Center">
                    <Button Command="{Binding TestParametersCommand}"
                            CommandParameter="{Binding Tree.SelectedKey}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            ToolTip="{l:Words main.test-parameters}"
                            Margin="2.5px">
                        <md:PackIcon Kind="CodeBraces" 
                                     Height="20" 
                                     Width="20"/>
                    </Button>
                    <ToggleButton Command="{Binding ToggleConstantCommand}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=TranslateOff, Size=25}"
                                  IsChecked="{Binding Tree.SelectedKeyNode.IsConstant, Mode=OneWay}"
                                  Visibility="{Binding Tree.SelectedKeyNode.CanBeConstant, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="{l:Words main.toggle-constant}"
                                  Margin="2.5px"/>
                    <ToggleButton Command="{Binding ToggleNeedsReviewCommand}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=HandFrontLeft, Size=25}"
                                  IsChecked="{Binding Tree.SelectedKeyNode.NeedsReview, Mode=OneWay}"
                                  ToolTip="{l:Words main.toggle-review}"
                                  Margin="2.5px"/>
                    <Button Command="{Binding ShowGripesCommand}"
                            CommandParameter="{Binding DefaultPreview}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding DefaultPreview.GripeCount, Converter={StaticResource NotZeroToVisibilityConverter}}"
                            ToolTip="{l:Words main.preview-gripes}"
                            Foreground="DarkOrange"
                            Padding="4 0"
                            Margin="2.5px">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AlertCircleOutline" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DefaultPreview.GripeCount}" VerticalAlignment="Center" Margin="3 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding ShowDefaultPreview}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=Eye, Size=35}"
                                  ToolTip="{l:Words main.display-preview}"
                                  Margin="2.5px"/>
                </StackPanel>
                <Border CornerRadius="3" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource PrimaryHueDarkBrush}" 
                        Grid.Row="1" 
                        Grid.Column="0" 
                        Grid.ColumnSpan="2">
                    <Grid>
                        <TextBox Text="{Binding Tree.SelectedKey.DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 TextAlignment="Left"
                                 SpellCheck.IsEnabled="True"
                                 Visibility="{Binding ShowDefaultPreview, Converter={StaticResource IsFalse}}"
                                 Margin="2.5px"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowDefaultPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="3.5 7 0 0">
                                <TextBlock uc:MarkdownPreview.Text="{Binding DefaultPreview.Text}"
                                           uc:MarkdownPreview.Settings="{Binding DefaultPreview.Settings}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <ComboBox ItemsSource="{Binding Tree.FileLanguages}"
                      SelectedItem="{Binding Tree.SelectedLanguage}"
                      DisplayMemberPath="NativeName"
                      Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                      Grid.Column="2" 
                      Grid.Row="0"
                      FontWeight="SemiBold"
                      FontSize="14"
                      Margin="2.5px">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <ContentPresenter Content="{Binding NativeName}" Margin="2.5px"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <ScrollViewer Grid.Column="2"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Tree.SelectedEntry, Converter={StaticResource IsNotNull}}"
                          Margin="3 0">
                <StackPanel>
                    <TextBlock Text="{l:Words main.translation-context}"
                               Margin="2.5px"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="0 0 30px 2.5px" 
                            BorderBrush="Green">
                        <TextBox Text="{Binding Tree.SelectedEntry.Context, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 TextAlignment="Left"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 Margin="2.5px"/>
                    </Border>
                    <TextBlock Text="{l:Words main.translation-comment}"
                               HorizontalAlignment="Right"
                               Margin="2.5px"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="30px 0 0 2.5px" 
                            BorderBrush="Black">
                        <TextBox Text="{Binding Tree.SelectedEntry.Comment, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 TextAlignment="Left"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 Margin="2.5px"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2"
                  Grid.Row="2"
                  Visibility="{Binding Tree.SelectedEntry, Converter={StaticResource IsNotNull}}"
                  Margin="3 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

				<md:ColorZone Mode="PrimaryLight" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Stretch" />
				
				<StackPanel Grid.Row="0" 
                            Grid.Column="0"  
                            VerticalAlignment="Center">
					<Grid Margin="2.5px"
						  Visibility="{Binding Tree.SelectedEntry.Stale, Converter={StaticResource IsNotNull}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Label Content="{l:Words main.stale}"/>
						<TextBlock Grid.Column="1" Text="{Binding Tree.SelectedEntry.Stale, Mode=OneWay}" VerticalAlignment="Center" ToolTip="{l:Words main.stale-tip}"/>
                    </Grid>
                    <TextBlock Text="{l:Words main.translation}"
                               Margin="2.5px"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" 
                            Grid.Row="0" 
                            Grid.Column="2">
                    <Button Command="{Binding TestParametersCommand}"
                            CommandParameter="{Binding Tree.SelectedKey}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            ToolTip="{l:Words main.test-parameters}"
                            Margin="2.5px">
                        <md:PackIcon Kind="CodeBraces"
                                     Height="20" 
                                     Width="20"/>
                    </Button>
                    <ToggleButton Command="{Binding ToggleStaleLanguageCommand}"
                                  CommandParameter="{Binding Tree.SelectedLanguage.Code}"
                                  IsChecked="{Binding Tree.SelectedKeyNode.IsStale, Mode=OneWay}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=ClockAlert,Size=30}"
                                  ToolTip="{l:Words main.toggle-stale}"
                                  Margin="2.5px"/>
                    <Button Command="{Binding ShowGripesCommand}"
                            CommandParameter="{Binding TranslationPreview}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding TranslationPreview.GripeCount, Converter={StaticResource NotZeroToVisibilityConverter}}"
                            ToolTip="{l:Words main.preview-gripes}"
                            Foreground="DarkOrange"
                            Padding="4 0"
                            Margin="2.5px">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AlertCircleOutline" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TranslationPreview.GripeCount}" VerticalAlignment="Center" Margin="3 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding ShowLocalizationPreview}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=Eye,Size=35}"
                                  ToolTip="{l:Words main.display-preview}"
                                  Margin="2.5px"/>
                </StackPanel>
                <Border CornerRadius="3" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource PrimaryHueDarkBrush}" 
                        Grid.Row="1"
                        Grid.Column="0" 
                        Grid.ColumnSpan="2">
                    <Grid>
                        <TextBox Text="{Binding Tree.SelectedEntry.Value, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextAlignment="Left"
                                 SpellCheck.IsEnabled="True"
                                 Visibility="{Binding ShowLocalizationPreview, Converter={StaticResource IsFalse}}"
                                 Margin="2.5px"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowLocalizationPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="3.5 7 0 0">
                                <TextBlock uc:MarkdownPreview.Text="{Binding TranslationPreview.Text}"
                                           uc:MarkdownPreview.Settings="{Binding TranslationPreview.Settings}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

			<md:ColorZone Mode="PrimaryLight" Grid.Row="3" Grid.ColumnSpan="3" VerticalAlignment="Stretch" />
			
			<StackPanel Grid.Column="0" 
                        Grid.Row="3"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding Tree.SelectedKeyNode, Converter={StaticResource IsNotNull}}"
                        Orientation="Horizontal">
                <Button Command="{Binding AddNodeCommand}"
                        Visibility="{Binding Tree.SelectedKeyNode.IsConstant, Converter={StaticResource IsFalseAndNotNull}, FallbackValue=Visible}"
                        ToolTip="{l:Words tool.add-node}"
                        Margin="2.5px">
                    <md:PackIcon Kind="PlusThick"/>
                </Button>
                <Button Command="{Binding RemoveNodeCommand}"
                        Visibility="{Binding Tree.SelectedKeyNode, Converter={StaticResource IsNotNull}}"
                        ToolTip="{l:Words tool.remove-node}"
                        Margin="2.5px">
                    <md:PackIcon Kind="Delete"/>
                </Button>
                <Button Command="{Binding AddOrganizerCommand}"
                        Visibility="{Binding Tree.SelectedKeyNode.IsFile, Converter={StaticResource IsFalseAndNotNull}, FallbackValue=Collapsed}"
                        ToolTip="{l:Words tool.add-comment}"
                        Margin="2.5px">
                    <md:PackIcon Kind="CommentPlus"/>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" 
                        Grid.Row="3"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding Tree.SelectedKeyNode, Converter={StaticResource IsNotNull}}">
                <Button Command="{Binding StaleAllLanguagesCommand}" 
                        Visibility="{Binding Tree.SelectedEntry, Converter={StaticResource IsNotNull}}"
                        ToolTip="{l:Words tool.stale-all}"
                        Margin="2.5px">
                    <md:PackIcon Kind="ClockAlert"/>
                </Button>
                <Button Command="{Binding RemoveKeyCommand}"
                        Visibility="{Binding Tree.SelectedKey, Converter={StaticResource IsNotNull}}"
                        ToolTip="{l:Words tool.remove-key}"
                        Margin="2.5px">
                    <md:PackIcon Kind="Delete"/>
                </Button>
                <StackPanel Visibility="{Binding Tree.SelectedKeyNode.IsFile, Converter={StaticResource IsFalseAndNotNull}, FallbackValue=Visible}">
                    <Button Command="{Binding AddKeyCommand}"
                            Visibility="{Binding Tree.SelectedKey, Converter={StaticResource Equals}, ConverterParameter={x:Null}}"
                            ToolTip="{l:Words tool.add-key}"
                            Margin="2.5px">
                        <md:PackIcon Kind="PlusThick"/>
                    </Button>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" 
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <!-- the language Wordsmith itself speaks; a change reopens the window in it -->
                <ComboBox ItemsSource="{Binding UiLanguages}"
                          SelectedValue="{Binding UiLanguage}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Value"
                          ToolTip="{l:Words app.language}"
                          VerticalAlignment="Center"
                          MinWidth="110"
                          Margin="2.5px 2.5px 10px 2.5px"/>
                <Button Command="{Binding ManageLanguagesCommand}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                        Margin="2.5px"
                        ToolTip="{l:Words tool.languages}">
                    <md:PackIcon Kind="Translate"/>
                </Button>
                <Button Command="{Binding SettingsCommand}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                        Margin="2.5px"
                        ToolTip="{l:Words tool.settings}">
                    <md:PackIcon Kind="Cog"/>
                </Button>
                <Button Command="{Binding MergeFilesCommand}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                        Margin="2.5px"
                        ToolTip="{l:Words tool.merge}">
                    <md:PackIcon Kind="Merge"/>
                </Button>
                <Button Command="{Binding LoadFileCommand}"
                        Margin="2.5px"
                        ToolTip="{l:Words tool.load}">
                    <md:PackIcon Kind="FolderUpload"/>
                </Button>
                <Button Command="{Binding SaveCommand}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                        Margin="2.5px"
                        ToolTip="{l:Words tool.save}">
                    <md:PackIcon Kind="ContentSave"/>
                </Button>
                <Button Command="{Binding ResetCommand}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                        ToolTip="{l:Words tool.reset}"
                        Margin="2.5px">
                    <md:PackIcon Kind="Reload"/>
                </Button>
            </StackPanel>

			<TextBlock Grid.Row="2"
					   Grid.Column="2"
					   VerticalAlignment="Bottom"
					   HorizontalAlignment="Right"
					   Foreground="{DynamicResource MaterialDesignLightForeground}"
					   Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource Equals}, ConverterParameter=0}">
				<Run FontSize="24" FontWeight="DemiBold" BaselineAlignment="Top" Text="{l:Words main.start-here}"/>
				<md:PackIcon Kind="ArrowBottomRightBoldOutline" Width="96" Height="96"/>
				<Run Text="         "/>
			</TextBlock>
        </Grid>
</Window>
