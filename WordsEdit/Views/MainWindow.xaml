<Window x:Class="WordsEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:WordsEdit.ViewModels" 
        xmlns:uc="clr-namespace:WordsEdit.Utils"
        xmlns:v="clr-namespace:WordsEdit.Views"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dd="urn:gong-wpf-dragdrop" 
        mc:Ignorable="d"
		d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="{Binding Title}"
        FontFamily="Montserrat"
		Height="640" Width="960"
        MinHeight="450" MinWidth="800"
        Closing="MainWindow_Closing">

    <Window.Resources>
		<md:EqualityToVisibilityConverter x:Key="Equals" />
		<md:NullableToVisibilityConverter x:Key="IsNotNull" />
		<md:BooleanToVisibilityConverter x:Key="IsFalse" TrueValue="Collapsed" FalseValue="Visible" />
        <uc:GenericValueConverter x:Key="IsFalseAndNotNull" Else="Collapsed">
            <uc:ConverterCondition When="{StaticResource False}" Then="Visible"/>
        </uc:GenericValueConverter>
		<uc:GenericValueConverter x:Key="BooleanToBoldConverter" Else="SemiBold">
			<uc:ConverterCondition When="{StaticResource True}" Then="ExtraBlack" />
		</uc:GenericValueConverter>
	</Window.Resources>

    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".8*"/>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

			<md:ColorZone Mode="PrimaryLight" Grid.Row="0" Grid.ColumnSpan="3" VerticalAlignment="Stretch" />

			<Grid   Grid.Column="0"
                    Grid.Row="0"
                    Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                    Margin="3 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <md:PackIcon Grid.Column="0" 
                             Kind="Magnify" 
                             Height="20"
                             Width="20"
                             VerticalAlignment="Center"/>
                <TextBox Text="{Binding Tree.SearchFilterText, UpdateSourceTrigger=PropertyChanged}" 
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         Margin="2.5px"/>
                <DockPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=ClockAlert,Size=25}"
                                  ToolTip="Stale View"
                                  IsChecked="{Binding Tree.IsStaleFilter}" 
                                  Margin="2.5px"/>
                    <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=HandFrontLeft,Size=25}"
                                  ToolTip="Review View"
                                  IsChecked="{Binding Tree.NeedsReviewFilter}" 
                                  Margin="2.5px"/>
                </DockPanel>
            </Grid>
            <Grid Grid.Column="0" 
                  Grid.Row="1" 
                  Grid.RowSpan="2" 
                  Margin="3 0">
                <Border CornerRadius="3" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}">
                    <TreeView ItemsSource="{Binding Tree.KeyNodes}"
					          SelectedItemChanged="TreeView_OnSelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AllowDrop="True"
                              dd:DragDrop.DragHandler="{Binding KeyDragDropHandler}"
                              dd:DragDrop.DropHandler="{Binding KeyDragDropHandler}"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" 
                                   BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                <Setter Property="IsExpanded" 
                                        Value="{Binding IsExpanded}"/>
                                <Setter Property="IsSelected" 
                                        Value="{Binding IsSelected}"/>
                                <Setter Property="Visibility" 
                                        Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:KeyNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="File" 
                                                 Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="TranslateOff" 
                                                 Visibility="{Binding IsConstant, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="HandFrontLeft" 
                                                 Foreground="Blue"
                                                 Visibility="{Binding NeedsReview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="ClockAlert" 
                                                 Foreground="Blue"
                                                 Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <md:PackIcon Kind="Eraser" 
                                                 Visibility="{Binding IsOverwritten, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="{Binding EmptyValue, Converter={StaticResource BooleanToBoldConverter}}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:OrganizerNode}">
                                <DockPanel Opacity="0.7" LastChildFill="True">
                                    <md:PackIcon Kind="CommentTextOutline" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Caption}"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center"
                                               Margin="4 0 0 0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Caption}"/>
                                </DockPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" 
                        Grid.Column="1"
                        Grid.Row="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center">
				<TextBlock Margin="2.5px"
                           FontWeight="SemiBold"
                           FontSize="18"
						   Text="{Binding Tree.SelectedKeyNode.Path, Mode=OneWay}"
						   ToolTip="{Binding Tree.SelectedKeyNode.Path}"/>
				<Button Padding="0 0 1 0" 
                        Margin="2 0 0 0" 
                        Height="16" 
                        Command="{Binding RenameLocalizationKeyAndNodeCommand}" 
                        Visibility="{Binding Tree.SelectedKeyNode.IsFile, Converter={StaticResource IsFalseAndNotNull},FallbackValue=Collapsed}"
                        ToolTip="Edit Name">
                    <md:PackIcon Kind="RenameBox"/>
                </Button>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="3 0">
                <StackPanel>
                <StackPanel Visibility="{Binding Tree.SelectedKey, Converter={StaticResource IsNotNull}}">
                    <TextBlock TextWrapping="Wrap"
                               Margin="2.5px"
                               Text="Context"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="0 0 30px 2.5px" 
                            BorderBrush="Green">
                        <TextBox Text="{Binding Tree.SelectedKey.Context, UpdateSourceTrigger=PropertyChanged}" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 TextAlignment="Left"
                                 Margin="2.5px"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               Margin="2.5px"
                               Text="Translator Comment"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="30px 0 0 2.5px" 
                            BorderBrush="Black">
                        <TextBox Text="{Binding Tree.SelectedKey.Comment, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 TextAlignment="Left"
                                 Margin="2.5px"/>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding Tree.SelectedOrganizer, Converter={StaticResource IsNotNull}}">
                    <TextBlock TextWrapping="Wrap"
                               Margin="2.5px"
                               Text="Freeform Comment"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3"
                            BorderThickness="1"
                            Margin="0 0 30px 2.5px"
                            BorderBrush="Gray">
                        <TextBox Text="{Binding Tree.SelectedOrganizer.Text, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 TextAlignment="Left"
                                 MinHeight="80"
                                 Margin="2.5px"/>
                    </Border>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1"
                  Grid.Row="2"
                  Visibility="{Binding Tree.SelectedKey, Converter={StaticResource IsNotNull}}"
                  Margin="3 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

				<md:ColorZone Mode="PrimaryLight" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Stretch" />

				<TextBlock Text="Default English"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="2.5px"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <StackPanel Orientation="Horizontal" 
                            Grid.Row="0" 
                            Grid.Column="1" 
                            VerticalAlignment="Center">
                    <Button Command="{Binding TestParametersCommand}"
                            CommandParameter="{Binding Tree.SelectedKey.Parameters}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            ToolTip="Test Parameters"
                            Margin="2.5px">
                        <md:PackIcon Kind="CodeBraces" 
                                     Height="20" 
                                     Width="20"/>
                    </Button>
                    <ToggleButton Command="{Binding ToggleLocalizationKeyIsConstantCommand}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=TranslateOff, Size=25}"
                                  IsChecked="{Binding Tree.SelectedKeyNode.IsConstant, Mode=OneWay}"
                                  Visibility="{Binding Tree.SelectedKeyNode.CanBeConstant, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip=" Toggle Constant (Does not need translation)"
                                  Margin="2.5px"/>
                    <ToggleButton Command="{Binding ToggleLocalizationKeyNeedsReviewCommand}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=HandFrontLeft, Size=25}"
                                  IsChecked="{Binding Tree.SelectedKeyNode.NeedsReview, Mode=OneWay}"
                                  ToolTip="Toggle needs review"
                                  Margin="2.5px"/>
                    <ToggleButton IsChecked="{Binding ShowDefaultPreview}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=Eye, Size=35}"
                                  ToolTip="Display Preview"
                                  Margin="2.5px"/>
                </StackPanel>
                <Border CornerRadius="3" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource PrimaryHueDarkBrush}" 
                        Grid.Row="1" 
                        Grid.Column="0" 
                        Grid.ColumnSpan="2">
                    <Grid>
                        <TextBox Text="{Binding Tree.SelectedKey.DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 TextAlignment="Left"
                                 SpellCheck.IsEnabled="True"
                                 Visibility="{Binding ShowDefaultPreview, Converter={StaticResource IsFalse}}"
                                 Margin="2.5px"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowDefaultPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="3.5 7 0 0">
                                <TextBlock uc:MarkdownPreview.Text="{Binding RenderedDefault}"
                                           uc:MarkdownPreview.Settings="{Binding DefaultPreviewSettings}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Left"/>
                                <TextBlock Text="{Binding DefaultPreviewError}"
                                           Visibility="{Binding DefaultPreviewError, Converter={StaticResource IsNotNull}}"
                                           Foreground="Red"
                                           TextWrapping="Wrap"
                                           Margin="0 7 0 0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <ComboBox ItemsSource="{Binding Tree.KnownLanguages}"
                      SelectedItem="{Binding Tree.SelectedLanguage}"
                      DisplayMemberPath="NativeName"
                      Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                      Grid.Column="2" 
                      Grid.Row="0"
                      FontWeight="SemiBold"
                      FontSize="14"
                      Margin="2.5px">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <ContentPresenter Content="{Binding NativeName}" Margin="2.5px"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <ScrollViewer Grid.Column="2"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Tree.SelectedEntry, Converter={StaticResource IsNotNull}}"
                          Margin="3 0">
                <StackPanel>
                    <TextBlock Text="Translation Context"
                               Margin="2.5px"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="0 0 30px 2.5px" 
                            BorderBrush="Green">
                        <TextBox Text="{Binding Tree.SelectedEntry.Context, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 TextAlignment="Left"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 Margin="2.5px"/>
                    </Border>
                    <TextBlock Text="Translation Comment"
                               HorizontalAlignment="Right"
                               Margin="2.5px"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Border CornerRadius="3" 
                            BorderThickness="1" 
                            Margin="30px 0 0 2.5px" 
                            BorderBrush="Black">
                        <TextBox Text="{Binding Tree.SelectedEntry.Comment, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 TextAlignment="Left"
                                 AcceptsReturn="True"
                                 SpellCheck.IsEnabled="True"
                                 Margin="2.5px"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2"
                  Grid.Row="2"
                  Visibility="{Binding Tree.SelectedEntry, Converter={StaticResource IsNotNull}}"
                  Margin="3 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

				<md:ColorZone Mode="PrimaryLight" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Stretch" />
				
				<StackPanel Grid.Row="0" 
                            Grid.Column="0"  
                            VerticalAlignment="Center">
					<Grid Margin="2.5px"
						  Visibility="{Binding Tree.SelectedEntry.Stale, Converter={StaticResource IsNotNull}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Label Content="Stale: "/>
						<TextBox Grid.Column="1" Text="{Binding Tree.SelectedEntry.Stale}" />
                    </Grid>
                    <TextBlock Text="Translation"
                               Margin="2.5px"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" 
                            Grid.Row="0" 
                            Grid.Column="2">
                    <Button Command="{Binding TestParametersCommand}"
                            CommandParameter="{Binding Tree.SelectedKey.Parameters}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            ToolTip="Test Parameters"
                            Margin="2.5px">
                        <md:PackIcon Kind="CodeBraces"
                                     Height="20" 
                                     Width="20"/>
                    </Button>
                    <ToggleButton Command="{Binding ToggleStaleLanguageCommand}"
                                  CommandParameter="{Binding Tree.SelectedLanguage.Code}"
                                  IsChecked="{Binding Tree.SelectedKeyNode.IsStale, Mode=OneWay}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=ClockAlert,Size=30}"
                                  ToolTip="Toggle Language is stale"
                                  Margin="2.5px"/>
                    <ToggleButton IsChecked="{Binding ShowLocalizationPreview}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Content="{md:PackIcon Kind=Eye,Size=35}"
                                  ToolTip="Display Preview"
                                  Margin="2.5px"/>
                </StackPanel>
                <Border CornerRadius="3" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource PrimaryHueDarkBrush}" 
                        Grid.Row="1"
                        Grid.Column="0" 
                        Grid.ColumnSpan="2">
                    <Grid>
                        <TextBox Text="{Binding Tree.SelectedEntry.Value, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextAlignment="Left"
                                 SpellCheck.IsEnabled="True"
                                 Visibility="{Binding ShowLocalizationPreview, Converter={StaticResource IsFalse}}"
                                 Margin="2.5px"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowLocalizationPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="3.5 7 0 0">
                                <TextBlock uc:MarkdownPreview.Text="{Binding RenderedTranslation}"
                                           uc:MarkdownPreview.Settings="{Binding TranslationPreviewSettings}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Left"/>
                                <TextBlock Text="{Binding TranslationPreviewError}"
                                           Visibility="{Binding TranslationPreviewError, Converter={StaticResource IsNotNull}}"
                                           Foreground="Red"
                                           TextWrapping="Wrap"
                                           Margin="0 7 0 0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

			<md:ColorZone Mode="PrimaryLight" Grid.Row="3" Grid.ColumnSpan="3" VerticalAlignment="Stretch" />
			
			<StackPanel Grid.Column="0" 
                        Grid.Row="3"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding Tree.SelectedKeyNode, Converter={StaticResource IsNotNull}}"
                        Orientation="Horizontal">
                <Button Command="{Binding AddLocalizationKeyNodeCommand}"
                        Visibility="{Binding Tree.SelectedKeyNode.IsConstant, Converter={StaticResource IsFalseAndNotNull}, FallbackValue=Visible}"
                        ToolTip="Add Key"
                        Margin="2.5px">
                    <md:PackIcon Kind="PlusThick"/>
                </Button>
                <Button Command="{Binding RemoveLocalizationKeyAndNodeCommand}"
                        Visibility="{Binding Tree.SelectedKeyNode, Converter={StaticResource IsNotNull}}"
                        ToolTip="Remove Key"
                        Margin="2.5px">
                    <md:PackIcon Kind="Delete"/>
                </Button>
                <Button Command="{Binding AddOrganizerCommand}"
                        Visibility="{Binding Tree.SelectedKeyNode.IsFile, Converter={StaticResource IsFalseAndNotNull}, FallbackValue=Collapsed}"
                        ToolTip="Add Comment"
                        Margin="2.5px">
                    <md:PackIcon Kind="CommentPlus"/>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" 
                        Grid.Row="3"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding Tree.SelectedKeyNode, Converter={StaticResource IsNotNull}}">
                <Button Command="{Binding StaleAllLanguagesCommand}" 
                        Visibility="{Binding Tree.SelectedEntry, Converter={StaticResource IsNotNull}}"
                        ToolTip="Set all localizations as stale"
                        Margin="2.5px">
                    <md:PackIcon Kind="ClockAlert"/>
                </Button>
                <Button Command="{Binding RemoveLocalizationKeyCommand}"
                        Visibility="{Binding Tree.SelectedKey, Converter={StaticResource IsNotNull}}"
                        ToolTip="Delete Key Information"
                        Margin="2.5px">
                    <md:PackIcon Kind="Delete"/>
                </Button>
                <StackPanel Visibility="{Binding Tree.SelectedKeyNode.IsFile, Converter={StaticResource IsFalseAndNotNull}, FallbackValue=Visible}">
                    <Button Command="{Binding AddLocalizationKeyCommand}"
                            Visibility="{Binding Tree.SelectedKey, Converter={StaticResource Equals}, ConverterParameter={x:Null}}"
                            ToolTip="Add Key Information"
                            Margin="2.5px">
                        <md:PackIcon Kind="PlusThick"/>
                    </Button>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" 
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <Button Command="{Binding ManageLanguagesCommand}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                        Margin="2.5px"
                        ToolTip="Manage Languages">
                    <md:PackIcon Kind="Translate"/>
                </Button>
                <Button Command="{Binding MergeFilesCommand}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                        Margin="2.5px"
                        ToolTip="Merge Files">
                    <md:PackIcon Kind="Merge"/>
                </Button>
                <Button Command="{Binding LoadFileCommand}"
                        Margin="2.5px"
                        ToolTip="Load Files">
                    <md:PackIcon Kind="FolderUpload"/>
                </Button>
                <Button Command="{Binding SaveCommand}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                        Margin="2.5px"
                        ToolTip="Save To Files">
                    <md:PackIcon Kind="ContentSave"/>
                </Button>
                <Button Command="{Binding ResetCommand}"
                        Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource NotZeroToVisibilityConverter}}"
                        ToolTip="Reset"
                        Margin="2.5px">
                    <md:PackIcon Kind="Reload"/>
                </Button>
            </StackPanel>

			<TextBlock Grid.Row="2"
					   Grid.Column="2"
					   VerticalAlignment="Bottom"
					   HorizontalAlignment="Right"
					   Foreground="{DynamicResource MaterialDesignLightForeground}"
					   Visibility="{Binding Tree.KeyNodes.Count, Converter={StaticResource Equals}, ConverterParameter=0}">
				<Run FontSize="24" FontWeight="DemiBold" BaselineAlignment="Top">Start Here</Run>
				<md:PackIcon Kind="ArrowBottomRightBoldOutline" Width="96" Height="96"/>
				<Run Text="         "/>
			</TextBlock>
        </Grid>
</Window>
