<UserControl x:Class="WordsEdit.Views.KeyNameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:KeyNameViewModel}"
             Padding="10">
    <!-- the Key Name window: the one field, checked as typed; Add or Rename, and Cancel -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="IsTrue"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding Title, Mode=OneWay}"
                   FontWeight="Bold"
                   FontSize="16"
                   Margin="2.5px"/>
        <HeaderedContentControl Header="{l:Words key-name.name}"
                                Margin="2.5px"
                                FontWeight="SemiBold">
            <TextBox Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}"
                     FontWeight="Normal"
                     Width="180"/>
        </HeaderedContentControl>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0">
            <Button Content="{l:Words key-name.add}"
                    Command="{Binding AddKeyCommand}"
                    Visibility="{Binding IsAddKey, Converter={StaticResource IsTrue}}"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="2.5px"/>
            <Button Content="{l:Words key-name.rename}"
                    Command="{Binding RenameKeyCommand}"
                    Visibility="{Binding IsRenameKey, Converter={StaticResource IsTrue}}"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="2.5px"/>
            <Button Content="{l:Words dialog.cancel}"
                    Command="{Binding CancelCommand}"
                    MinWidth="80"
                    Margin="2.5px"/>
        </StackPanel>
    </StackPanel>
</UserControl>
