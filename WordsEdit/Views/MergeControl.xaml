<UserControl x:Class="WordsEdit.Views.MergeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WordsEdit.Views"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:MergeControlViewModel}"
             Height="450" Width="800"
             MinHeight="450" MinWidth="800"
             Padding="2.5px">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="IsTrue"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: Key Nodes and Languages -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
            </Grid.RowDefinitions>

            <TextBlock Text="Files To Merge" FontSize="16" FontWeight="Bold" Margin="10" />
            <!-- Key Node Sections -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" x:Name="FilesToMergeScrollViewer">
                <ItemsControl ItemsSource="{Binding FilesToMerge}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10">
                                <DockPanel>
                                    <TextBlock Text="{Binding FullLabel}" FontSize="14" FontWeight="Bold" />
                                    <RadioButton Content="Base File"
                                                 GroupName="BaseFileGroup"
                                                 Command="{Binding DataContext.SetBaseFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}" 
                                                 IsChecked="{Binding IsBaseFile}"
                                                 HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Expander Header="Selected Languages" IsExpanded="False">
                                    <ListBox ItemsSource="{Binding DataContext.Languages,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             SelectionMode="Multiple" 
                                             PreviewMouseWheel="FilesToMergeListBox_PreviewMouseWheel"
                                             SelectionChanged="LanguageListBox_OnSelectionChanged"
                                             Margin="30 0 0 0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding EnglishName}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto"    />
            </Grid.RowDefinitions>

            <TextBlock Text="Available Files" FontSize="16" FontWeight="Bold" Margin="10"  Grid.Row="0"/>


            <Grid Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Right Side: Files To Merge -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0" MaxHeight="250" x:Name="AvailableFilesScrollViewer">
                    <ListBox ItemsSource="{Binding AvailableFiles}" 
                             SelectionChanged="FileListBox_OnSelectionChanged"
                             PreviewMouseWheel="AvailableFilesListBox_PreviewMouseWheel"
                             SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullLabel}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Warning Message -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" MinHeight="200" Visibility="{Binding HasConflict,Converter={StaticResource IsTrue}}">
                    <TextBlock Text="{Binding ConflictMessage}" Foreground="Red" Margin="5" TextWrapping="Wrap"/>
                </ScrollViewer>

            </Grid>
            <!-- Bottom: Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Merge" Command="{Binding MergeCommand}" IsEnabled="{Binding CanMerge}" Width="100" Height="40" Margin="5"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Height="40" Margin="5" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
