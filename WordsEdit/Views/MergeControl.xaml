<UserControl x:Class="WordsEdit.Views.MergeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WordsEdit.Views"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:MergeControlViewModel}"
             MinWidth="700"
             Padding="2.5px">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="IsTrue"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left Side: the files taking part, each with the languages it supplies -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
            </Grid.RowDefinitions>

            <TextBlock Text="Files To Merge" FontSize="16" FontWeight="Bold" Margin="10" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" MinHeight="150" MaxHeight="350">
                <ItemsControl ItemsSource="{Binding Selected}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10">
                                <DockPanel>
                                    <RadioButton Content="Base File"
                                                 GroupName="BaseFileGroup"
                                                 IsChecked="{Binding IsBase}"
                                                 DockPanel.Dock="Right"
                                                 HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Bold" />
                                </DockPanel>
                                <Expander Header="Languages" IsExpanded="False">
                                    <ItemsControl ItemsSource="{Binding Languages}" Margin="30 0 0 0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="0 2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Right Side: every loaded file, ticked to take part -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto"    />
            </Grid.RowDefinitions>

            <TextBlock Text="Available Files" FontSize="16" FontWeight="Bold" Margin="10"  Grid.Row="0"/>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0" MaxHeight="250">
                    <ItemsControl ItemsSource="{Binding Files}" Margin="10 0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0 2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Warning Message -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" MaxHeight="200" Visibility="{Binding HasConflict,Converter={StaticResource IsTrue}}">
                    <TextBlock Text="{Binding ConflictMessage}" Foreground="Red" Margin="5" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
            <!-- Bottom: Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Merge" Command="{Binding MergeCommand}" IsEnabled="{Binding CanMerge}" Width="100" Height="40" Margin="5"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Height="40" Margin="5" />
            </StackPanel>
        </Grid>

        <!-- Split: the other direction — one language of one file, written on its own for a translator -->
        <GroupBox Header="Split one language out" Grid.Row="1" Grid.ColumnSpan="2" Margin="10 10 10 0" Padding="5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Split…" Command="{Binding SplitCommand}" Width="100" Height="40" Margin="5"
                        ToolTip="Write the language's entries, with the defaults for reference, to a file of their own and load it"/>
                <TextBlock Text="File" VerticalAlignment="Center" Margin="5 0"/>
                <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SplitFile}" DisplayMemberPath="Label" MinWidth="160" Margin="5"/>
                <TextBlock Text="Language" VerticalAlignment="Center" Margin="10 0 5 0"/>
                <ComboBox ItemsSource="{Binding SplitLanguages}" SelectedItem="{Binding SplitLanguage}" DisplayMemberPath="EnglishName" MinWidth="160" Margin="5"/>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
