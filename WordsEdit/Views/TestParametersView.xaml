<UserControl x:Class="WordsEdit.Views.TestParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:uc="clr-namespace:WordsEdit.Utils"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels" 
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:TestParametersViewModel}"
             Padding="7px">
    <Grid>
        <StackPanel Grid.IsSharedSizeScope="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBox Text="{Binding Key,UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Top"
                                         TextWrapping="Wrap"
                                         MinWidth="25"/>
                                <TextBlock Text=":" Margin="10, 0, 10, 0"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Top"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinWidth="100"/>
                                <ComboBox ItemsSource="{Binding DataContext.DataTypes,RelativeSource={uc:FindAncestor UserControl}}" 
										  SelectedItem="{Binding DataType}"
                                          VerticalAlignment="Top"
                                          MinWidth="50"
                                          Margin="10, 0, 10, 0"
                                          DisplayMemberPath="Name"
                                          FontWeight="Bold">
                                </ComboBox>
                                <Button Command="{Binding DataContext.RemoveParameterCommand,RelativeSource={uc:FindAncestor UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Right"
                                        Width="50"
                                        Margin="2.5px">
                                    <md:PackIcon Kind="Delete"/>
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Content="Add Parameter"
                    Command="{Binding AddParameterCommand}"
                    Margin="2.5px"/>
            <!-- the default formatted with these samples, as the previews will show it -->
            <TextBlock Text="Result" FontWeight="SemiBold" Margin="2.5px 10px 2.5px 2.5px"/>
            <TextBlock Text="{Binding Result}" TextWrapping="Wrap" MaxWidth="500" Margin="2.5px">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    Margin="2.5px 10px 2.5px 2.5px"/>
        </StackPanel>
    </Grid>
</UserControl>
