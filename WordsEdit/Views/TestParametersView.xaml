<UserControl x:Class="WordsEdit.Views.TestParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:uc="clr-namespace:WordsEdit.Utils"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TestParametersViewModel}"
             Padding="10">
    <!-- the Test Parameters window (SPEC: The baseline pane): the key's parameters as a
         table of name, type and sample, a trash on each row and a + under them; the
         default formatted with the samples below, live -->
    <StackPanel Grid.IsSharedSizeScope="True">
        <TextBlock Text="{l:Words parameters.title}"
                   FontWeight="Bold"
                   FontSize="16"
                   Margin="2.5px"/>
        <Grid Margin="2.5px 2.5px 2.5px 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Type"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Sample"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Trash"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{l:Words parameters.name}" FontWeight="SemiBold" Margin="2.5px"/>
            <TextBlock Grid.Column="1" Text="{l:Words parameters.type}" FontWeight="SemiBold" Margin="2.5px"/>
            <TextBlock Grid.Column="2" Text="{l:Words parameters.sample}" FontWeight="SemiBold" Margin="2.5px"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
            <ItemsControl ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2.5px 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Type"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Sample"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Trash"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Top"
                                     Width="110"
                                     Margin="2.5px"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding DataContext.DataTypes, RelativeSource={uc:FindAncestor UserControl}}"
                                      SelectedItem="{Binding DataType}"
                                      DisplayMemberPath="Name"
                                      VerticalAlignment="Top"
                                      Width="110"
                                      Margin="2.5px"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Top"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Width="240"
                                     Margin="2.5px"/>
                            <Button Grid.Column="3"
                                    Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={uc:FindAncestor UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{l:Words parameters.remove}"
                                    Style="{StaticResource ToolButton}"
                                    VerticalAlignment="Top"
                                    Margin="2.5px">
                                <md:PackIcon Kind="Delete"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Command="{Binding AddParameterCommand}"
                ToolTip="{l:Words parameters.add}"
                Style="{StaticResource ToolButton}"
                HorizontalAlignment="Left"
                Margin="5px 2.5px 2.5px 2.5px">
            <md:PackIcon Kind="Plus"/>
        </Button>

        <!-- the default formatted with these samples, as the previews will show it; red when it will not -->
        <TextBlock Text="{l:Words parameters.result}"
                   FontWeight="SemiBold"
                   Margin="2.5px 10px 2.5px 2.5px"/>
        <TextBlock Text="{Binding Result}"
                   TextWrapping="Wrap"
                   MaxWidth="500"
                   HorizontalAlignment="Left"
                   Margin="2.5px">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Button Content="{l:Words dialog.close}"
                Command="{Binding CloseCommand}"
                HorizontalAlignment="Right"
                MinWidth="80"
                Margin="2.5px 10px 2.5px 2.5px"/>
    </StackPanel>
</UserControl>
