<UserControl x:Class="WordsEdit.Views.EditLanguageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="pattech.words"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WordsEdit.ViewModels" 
			 xmlns:m="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:EditLanguageViewModel, IsDesignTimeCreatable=False}"
             Padding="7px">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="IsTrue" />
		<m:BooleanToVisibilityConverter x:Key="IsFalse" TrueValue="Collapsed" FalseValue="Visible" />
	</UserControl.Resources>
    <Grid>
        <StackPanel Grid.IsSharedSizeScope="True">
            <HeaderedContentControl Header="{l:Words language.code}"
                                    Margin="2.5px"
                                    FontWeight="SemiBold">
                <TextBox Text="{Binding LanguageCode, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         FontWeight="Normal"
                         Width="100"/>
            </HeaderedContentControl>
            <HeaderedContentControl Header="{l:Words language.native-name}"
                                    FontWeight="SemiBold"
                                    Margin="2.5px">
                <TextBox Text="{Binding NativeName, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         FontWeight="Normal"
                         Width="100"/>
            </HeaderedContentControl>
            <HeaderedContentControl Header="{l:Words language.english-name}"
                                    FontWeight="SemiBold"
                                    Margin="2.5px">
                <TextBox Text="{Binding EnglishName, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         FontWeight="Normal"
                         Width="100"/>
            </HeaderedContentControl>
            <Button Content="{l:Words language.add}"
                    Command="{Binding AddLanguageCommand}"
                    Visibility="{Binding IsEdit, Converter={StaticResource IsFalse}}"
                    Margin="2.5px"/>
            <Button Content="{l:Words language.edit}"
                    Command="{Binding EditLanguageCommand}"
                    Visibility="{Binding IsEdit, Converter={StaticResource IsTrue}}"
                    Margin="2.5px"/>
            <Button Content="{l:Words dialog.cancel}"
                    Command="{Binding CancelCommand}"
                    Margin="2.5px"/>
        </StackPanel>
    </Grid>
</UserControl>
