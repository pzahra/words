<UserControl x:Class="WordsEdit.Views.ImageSchemesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:uc="clr-namespace:WordsEdit.Utils"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImageSchemesViewModel}"
             Padding="10px">
    <Grid>
        <StackPanel MinWidth="380">
            <TextBlock FontWeight="Bold" FontSize="16" Margin="2.5px">
                <Run Text="Image schemes — "/><Run Text="{Binding FileLabel, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="2.5px" Opacity="0.7"
                       Text="Map an image URI scheme to a folder (relative to this file). The preview looks each image's path up under that folder; unmapped schemes show the alt text instead."/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250" Margin="0,5,0,0">
                <ItemsControl ItemsSource="{Binding Mappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2.5,0,2.5">
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding DataContext.RemoveCommand,RelativeSource={uc:FindAncestor UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="40"
                                        Margin="5,0,0,0"
                                        ToolTip="Remove this mapping">
                                    <md:PackIcon Kind="Delete"/>
                                </Button>
                                <TextBox Text="{Binding Scheme,UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Top"
                                         Width="110"
                                         md:HintAssist.Hint="scheme"/>
                                <TextBlock Text=":" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Folder,UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Top"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="False"
                                         md:HintAssist.Hint="folder relative to the file"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Content="Add Mapping"
                    Command="{Binding AddCommand}"
                    Margin="2.5px"/>
            <Button Content="Ok"
                    Command="{Binding OkayCommand}"
                    Margin="2.5px"/>
        </StackPanel>
    </Grid>
</UserControl>
