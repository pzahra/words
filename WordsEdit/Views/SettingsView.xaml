<UserControl x:Class="WordsEdit.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:uc="clr-namespace:WordsEdit.Utils"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Padding="10px">
    <UserControl.Resources>
        <md:NullableToVisibilityConverter x:Key="IsNotNull" />
        <BooleanToVisibilityConverter x:Key="IsTrue" />
    </UserControl.Resources>
    <StackPanel MinWidth="560" MaxWidth="760" Grid.IsSharedSizeScope="True">
        <TextBlock FontWeight="Bold" FontSize="16" Margin="2.5px">
            <Run Text="Project settings — "/><Run Text="{Binding FileLabel, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="2.5px" Opacity="0.7"
                   Text="The dictionary names its settings files here (paths relative to the dictionary). A language's file applies while previewing that language, its rules over the dictionary's."/>

        <Grid Margin="2.5px 5px">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="who"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding FileLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <TextBox Grid.Column="1" Text="{Binding SettingsFile, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="wordsmith.ini"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Languages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2.5px">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="who"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0 0 10 0">
                            <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>
                        <TextBox Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="none"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0 10"/>

        <DockPanel Margin="2.5px">
            <TextBlock Text="Rules in" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="Label"/>
        </DockPanel>

        <StackPanel Visibility="{Binding Document, Converter={StaticResource IsNotNull}}" DataContext="{Binding Document}">
            <TextBlock Text="[images]" FontWeight="SemiBold" Margin="2.5px 8px 2.5px 0"/>
            <TextBlock TextWrapping="Wrap" Margin="2.5px" Opacity="0.7"
                       Text="scheme, the folder its paths are looked up under (relative to this settings file), and for a scheme that is not built in a /pattern/options/replacement rule that turns the URI into the path."/>
            <ItemsControl ItemsSource="{Binding Images}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0 2.5">
                            <Button DockPanel.Dock="Right" Width="36" Margin="5 0 0 0" ToolTip="Remove this rule"
                                    Command="{Binding DataContext.RemoveImageCommand, RelativeSource={uc:FindAncestor ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <md:PackIcon Kind="Delete"/>
                            </Button>
                            <TextBox Text="{Binding Scheme, UpdateSourceTrigger=PropertyChanged}" Width="90" md:HintAssist.Hint="scheme" VerticalAlignment="Top"/>
                            <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="8 0 0 0" md:HintAssist.Hint="folder" VerticalAlignment="Top"/>
                            <TextBox Text="{Binding Decode, UpdateSourceTrigger=PropertyChanged}" Margin="8 0 0 0" md:HintAssist.Hint="/pattern/options/replacement" VerticalAlignment="Top"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add image rule" Command="{Binding AddImageCommand}" HorizontalAlignment="Left" Margin="2.5px"/>

            <TextBlock Text="[hyperlinks]" FontWeight="SemiBold" Margin="2.5px 8px 2.5px 0"/>
            <TextBlock TextWrapping="Wrap" Margin="2.5px" Opacity="0.7"
                       Text="scheme, whether a click launches the target (shellexec, after confirming) or only shows it (popup), and a rule that rewrites the URI first. Unlisted: web and mail links launch, anything else is shown."/>
            <ItemsControl ItemsSource="{Binding Links}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0 2.5">
                            <Button DockPanel.Dock="Right" Width="36" Margin="5 0 0 0" ToolTip="Remove this rule"
                                    Command="{Binding DataContext.RemoveLinkCommand, RelativeSource={uc:FindAncestor ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <md:PackIcon Kind="Delete"/>
                            </Button>
                            <TextBox Text="{Binding Scheme, UpdateSourceTrigger=PropertyChanged}" Width="90" md:HintAssist.Hint="scheme" VerticalAlignment="Top"/>
                            <ComboBox ItemsSource="{x:Static vm:LinkRuleRow.Modes}" SelectedItem="{Binding Mode}" Width="110" Margin="8 0 0 0" md:HintAssist.Hint="default" VerticalAlignment="Top"/>
                            <TextBox Text="{Binding Decode, UpdateSourceTrigger=PropertyChanged}" Margin="8 0 0 0" md:HintAssist.Hint="/pattern/options/replacement" VerticalAlignment="Top"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add hyperlink rule" Command="{Binding AddLinkCommand}" HorizontalAlignment="Left" Margin="2.5px"/>

            <ItemsControl ItemsSource="{Binding Errors}" Margin="2.5px 8px 2.5px 0"
                          Visibility="{Binding HasErrors, Converter={StaticResource IsTrue}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Red" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="Ok" Command="{Binding OkayCommand}" Width="100" Margin="2.5px"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Margin="2.5px"/>
        </StackPanel>
    </StackPanel>
</UserControl>
