<UserControl x:Class="WordsEdit.Views.ToolbarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:uc="clr-namespace:WordsEdit.Utils"
             xmlns:vm="clr-namespace:WordsEdit.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ToolbarsViewModel}"
             Padding="10">
    <!-- the toolbar editor (SPEC: The toolbar editor): a row of chips for each toolbar and the bucket
         below; a chip is dragged between them, and the window behind follows -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="IsTrue"/>
        <!-- a chip: its icon, or its caption where it has none, or a break's line; a pin on a pinned
             one; the orange of a gripe in an odd place, its tooltip saying which pane it is about -->
        <DataTemplate x:Key="Chip" DataType="{x:Type vm:ToolbarChip}">
            <Border x:Name="Face"
                    CornerRadius="3"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    Background="{DynamicResource MaterialDesignPaper}"
                    Padding="5 3"
                    Margin="2"
                    MinWidth="30"
                    MinHeight="30"
                    Cursor="SizeAll">
                <Border.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Caption}"/>
                        <TextBlock Text="{Binding Odd}" Visibility="{Binding IsOdd, Converter={StaticResource IsTrue}}" FontStyle="Italic"/>
                    </StackPanel>
                </Border.ToolTip>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <md:PackIcon Kind="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource IsTrue}}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Caption}" Visibility="{Binding ShowsCaption, Converter={StaticResource IsTrue}}" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="18" Fill="{DynamicResource MaterialDesignBody}" Visibility="{Binding IsBreak, Converter={StaticResource IsTrue}}"/>
                    <md:PackIcon Kind="Pin" Width="12" Height="12" Margin="3 0 0 0" Opacity="0.6" VerticalAlignment="Top"
                                 Visibility="{Binding IsPinned, Converter={StaticResource IsTrue}}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOdd}" Value="True">
                    <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource WordsmithOrangeBrush}"/>
                    <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- the chips of a row or of the bucket, wrapping; empty, it still takes a drop -->
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <StackPanel MinWidth="620" MaxWidth="860">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="2.5px"/>
        <TextBlock TextWrapping="Wrap" Margin="2.5px" Opacity="0.7" Text="{l:Words toolbars.blurb}"/>

        <!-- the board: a row for each toolbar, its caption and its place beside it; the one whose
             context menu opened the dialog marked -->
        <ItemsControl ItemsSource="{Binding Rows}" Grid.IsSharedSizeScope="True" Margin="0 6 0 0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToolbarRow}">
                    <Grid Margin="2.5px">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="caption"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0 0 10 0">
                            <TextBlock Text="{Binding Toolbar.Caption}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Toolbar.Place}" Opacity="0.7" FontSize="11"/>
                        </StackPanel>
                        <Border x:Name="Lane"
                                Grid.Column="1"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource PrimaryHueDarkBrush}">
                            <ItemsControl ItemsSource="{Binding Chips}"
                                          ItemTemplate="{StaticResource Chip}"
                                          ItemsPanel="{StaticResource Wrap}"
                                          Background="Transparent"
                                          MinHeight="38"
                                          Padding="2"
                                          dd:DragDrop.IsDragSource="True"
                                          dd:DragDrop.IsDropTarget="True"
                                          dd:DragDrop.DragHandler="{Binding Drag}"
                                          dd:DragDrop.DropHandler="{Binding Drag}"/>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMarked}" Value="True">
                            <Setter TargetName="Lane" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                            <Setter TargetName="Lane" Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- what sits on no toolbar, a break first to drag out; the help bubble points here -->
        <TextBlock Text="{l:Words toolbars.bucket}" FontWeight="SemiBold" Margin="2.5px 10 2.5px 2.5px"/>
        <Border CornerRadius="3"
                BorderThickness="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="{DynamicResource MaterialDesignToolBarBackground}"
                Margin="2.5px"
                uc:Bubble.Topic="toolbars">
            <ItemsControl ItemsSource="{Binding Bucket}"
                          ItemTemplate="{StaticResource Chip}"
                          ItemsPanel="{StaticResource Wrap}"
                          Background="Transparent"
                          MinHeight="38"
                          Padding="2"
                          dd:DragDrop.IsDragSource="True"
                          dd:DragDrop.IsDropTarget="True"
                          dd:DragDrop.DragHandler="{Binding Drag}"
                          dd:DragDrop.DropHandler="{Binding Drag}"/>
        </Border>

        <!-- each entry over the pane it is not about, named -->
        <ItemsControl ItemsSource="{Binding OddPlaces}" Margin="2.5px 6 2.5px 0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{StaticResource WordsmithOrangeBrush}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0 10 0 0">
            <Button DockPanel.Dock="Left" Content="{l:Words toolbars.reset}" Command="{Binding ResetCommand}" MinWidth="80" Margin="2.5px"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Words dialog.ok}" Command="{Binding OkayCommand}" IsDefault="True" MinWidth="80" Margin="2.5px"/>
                <Button Content="{l:Words dialog.cancel}" Command="{Binding CancelCommand}" MinWidth="80" Margin="2.5px"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
