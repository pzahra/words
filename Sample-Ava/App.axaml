<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sample_Ava.App"
             xmlns:local="using:Sample_Ava"
             xmlns:c="using:Sample_Ava.Controls"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:sys="using:System"
             xmlns:shared="using:Sample_Shared"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- finds each page's view by its view model's name: XPageViewModel shows as XPageView -->
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- the package's ready-made converters: WordsMarkdown, WordsFormat,
                     WordsEnumDescription, WordsFlagsDescription(List), WordsParamsArray, WordsResourceVisual -->
                <ResourceInclude Source="avares://PatTech.Localization.Avalonia/Converters.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- theme-scoped: the variant the app is in picks the value, so a dynres:
                 image of ThemeIcon turns from sun to moon with the dark-theme switch —
                 and from gold to silver, its brush asked for the same way
                 (?foreground=dynres:ThemeIconBrush) — while a staticres: one keeps
                 whatever it resolved at load. The pane, card and chip brushes follow too,
                 and so does every markdown link, through WordsLinkBrush -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ThemeIconBrush" Color="Goldenrod"/>
                    <StreamGeometry x:Key="ThemeIcon">M8,0 L9.5,2.5 L6.5,2.5 Z M8,16 L6.5,13.5 L9.5,13.5 Z M0,8 L2.5,6.5 L2.5,9.5 Z M16,8 L13.5,9.5 L13.5,6.5 Z M2.3,2.3 L5,3 L3,5 Z M13.7,2.3 L13,5 L11,3 Z M2.3,13.7 L3,11 L5,13 Z M13.7,13.7 L11,13 L13,11 Z M8,4.5 A3.5,3.5 0 1 1 8,11.5 A3.5,3.5 0 1 1 8,4.5 Z</StreamGeometry>
                    <SolidColorBrush x:Key="PaneBackground" Color="#F3F3F5"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#FAFAFB"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#DDDDE3"/>
                    <SolidColorBrush x:Key="ChipBackground" Color="#E9E9EF"/>
                    <!-- the sample's own link colour, over the package's default -->
                    <SolidColorBrush x:Key="WordsLinkBrush" Color="#0A58CA"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ThemeIconBrush" Color="Silver"/>
                    <StreamGeometry x:Key="ThemeIcon">M8,0 A8,8 0 0 0 8,16 A4,8 0 0 1 8,0 Z</StreamGeometry>
                    <SolidColorBrush x:Key="PaneBackground" Color="#252527"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#27272A"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#3C3C42"/>
                    <SolidColorBrush x:Key="ChipBackground" Color="#35353C"/>
                    <SolidColorBrush x:Key="WordsLinkBrush" Color="#6EA8FE"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- resolved by markdown images through the staticres: and dynres: schemes -->
            <StreamGeometry x:Key="StarGeometry">M 8,0 L 10.47,5.53 16,6.11 11.8,9.88 13.06,16 8,12.94 2.94,16 4.2,9.88 0,6.11 5.53,5.53 Z</StreamGeometry>
            <!-- a control can't be shared between images, so a DataTemplate is its reusable form: built fresh each time -->
            <DataTemplate x:Key="HeartTemplate">
                <Path Data="M 8,14 C 8,14 1,9 1,5 A 3.5,3.5 0 0 1 8,4 A 3.5,3.5 0 0 1 15,5 C 15,9 8,14 8,14 Z" Fill="Crimson" Stretch="Uniform"/>
            </DataTemplate>
            <!-- the dot beside a topic not yet seen at its latest revision: one colour, both themes -->
            <SolidColorBrush x:Key="UnseenBrush" Color="#E8590C"/>

            <!-- a card's How: the files it is made of, cut from the real ones -->
            <c:CardHowConverter x:Key="CardHow"/>
            <!-- the Fluent expander is a full-width bar; a card's How wants a plain line
                 instead: a triangle that turns as it opens, and the header beside it -->
            <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
                <Setter Property="Template">
                    <ControlTemplate>
                        <StackPanel>
                            <ToggleButton IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Left" Cursor="Hand">
                                <ToggleButton.Theme>
                                    <ControlTheme TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <ContentPresenter Content="{TemplateBinding Content}" Background="Transparent"/>
                                            </ControlTemplate>
                                        </Setter>
                                    </ControlTheme>
                                </ToggleButton.Theme>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Name="Arrow" Text="&#x25B8;" Margin="0,0,5,0"/>
                                    <ContentPresenter Content="{TemplateBinding Header}"/>
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:expanded /template/ TextBlock#Arrow">
                    <Setter Property="Text" Value="&#x25BE;"/>
                </Style>
            </ControlTheme>

            <!-- a demonstration: heading and guidance (filled by DemoCard from its Key),
                 the live result, chips naming what it uses, and how it is made: each file's
                 part under a label naming it, as text to select and copy -->
            <ControlTheme x:Key="{x:Type c:DemoCard}" TargetType="c:DemoCard">
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Name="PART_Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Name="PART_Guide" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="{l:Words card.uses}" Opacity="0.6" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ItemsControl ItemsSource="{TemplateBinding UsesList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <Border Background="{DynamicResource ChipBackground}" CornerRadius="3" Padding="6,1" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                                <Expander Header="{l:Words card.how}" FontSize="11" Margin="0,6,0,0">
                                    <ItemsControl>
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{StaticResource CardHow}">
                                                <Binding Path="DataContext" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Key" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="MoreKeys" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="shared:CardSource">
                                                <StackPanel Margin="0,6,0,0">
                                                    <TextBlock Opacity="0.6"><l:WordsInline Key="card.how.from" Params="{Binding}"/></TextBlock>
                                                    <!-- read-only text, so it can be selected and copied; in the
                                                         code spans' font and tint, long lines wrapped -->
                                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                             FontFamily="{DynamicResource WordsCodeFont}" FontSize="12"
                                                             Background="{DynamicResource WordsCodeBackground}"
                                                             BorderThickness="0" Padding="4,2" MinHeight="0" Margin="0,2,0,0">
                                                        <TextBox.Styles>
                                                            <!-- the Fluent box repaints itself on hover and focus; this one keeps its tint -->
                                                            <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement">
                                                                <Setter Property="Background" Value="{DynamicResource WordsCodeBackground}"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                            </Style>
                                                        </TextBox.Styles>
                                                    </TextBox>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>
</Application>
