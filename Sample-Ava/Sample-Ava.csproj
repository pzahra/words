<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- every word this sample can name, for the analyzer's key check -->
    <AdditionalFiles Include="Assets\framework-words.ini;..\Sample-Shared\sample-words.ini" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Assets\globe.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\globe.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- the pages' markup as written, beside the compiled pages, for each card's How -->
    <EmbeddedResource Include="Views\Pages\*.axaml" LogicalName="pages/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 12, on Words for Avalonia 12 (the runtime SPEC: Avalonia 12); Avalonia 12
         drops Avalonia.Diagnostics, which the sample never called -->
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <!-- pinned by hand, as in Localization-Core.csproj: bumped once that version is on nuget.org -->
    <PackageReference Include="PatTech.Localization.Analyzer" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Localization-Ava12\Localization-Ava12.csproj" />
    <!-- the shared words, topics and config -->
    <ProjectReference Include="..\Sample-Shared\Sample-Shared.csproj" />
  </ItemGroup>
</Project>
