<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:c="using:Sample_Ava.Controls"
             xmlns:vm="using:Sample_Shared.ViewModels"
             x:Class="Sample_Ava.Views.StartPageView"
             x:DataType="vm:StartPageViewModel">
  <!-- Getting started. Each card's words are `<card key>`, `.guide` and `.demo` in
       Sample-Shared/sample.ini -->
  <StackPanel>
    <!-- card: start.markup -->
    <c:DemoCard Key="start.markup" Uses="{}{l:Words key}">
      <StackPanel>
        <!-- translated for every language the sample offers -->
        <TextBlock TextWrapping="Wrap" Text="{l:Words start.markup.demo}"/>
        <!-- only a default value: every language falls back to it -->
        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:Words start.markup.fallback}"/>
      </StackPanel>
    </c:DemoCard>
    <!-- /card -->

    <!-- card: start.missing -->
    <c:DemoCard Key="start.missing" Uses="{}{l:Words key}, Words.Logger">
      <!-- a typo on purpose: no such key, so it shows as itself between hashes -->
      <TextBlock TextWrapping="Wrap" Text="{l:Words start.missing.tpyo}"/>
    </c:DemoCard>
    <!-- /card -->
  </StackPanel>
</UserControl>
