<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/pzahra/words"
             xmlns:c="using:Sample_Ava.Controls"
             xmlns:vm="using:Sample_Shared.ViewModels"
             x:Class="Sample_Ava.Views.ParametersPageView"
             x:DataType="vm:ParametersPageViewModel">
  <!-- Format parameters: what fills a value's {0} and {Name} placeholders -->
  <StackPanel>
    <!-- card: parameters.positional -->
    <c:DemoCard Key="parameters.positional" Uses="WordsInline, Args">
      <StackPanel>
        <!-- a child Binding is the argument: no array-building property, no MultiBinding -->
        <TextBlock TextWrapping="Wrap"><l:WordsInline Key="parameters.positional.demo"><Binding Path="Unread"/></l:WordsInline></TextBlock>
        <Slider Margin="0,6,0,0" Minimum="0" Maximum="42" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Unread}"/>
      </StackPanel>
    </c:DemoCard>
    <!-- /card -->

    <!-- card: parameters.named -->
    <c:DemoCard Key="parameters.named" Uses="WordsInline, Params">
      <TextBlock TextWrapping="Wrap"><l:WordsInline Key="parameters.named.demo" Params="{Binding Profile}"/></TextBlock>
    </c:DemoCard>
    <!-- /card -->

    <!-- card: parameters.culture -->
    <c:DemoCard Key="parameters.culture" Uses="WordsInline, Params, UseSystemNumbers">
      <StackPanel>
        <TextBlock TextWrapping="Wrap"><l:WordsInline Key="parameters.culture.demo" Params="{Binding Sample}"/></TextBlock>
        <!-- flips the live builder's UseSystemNumbers and digests the language again -->
        <CheckBox Margin="0,6,0,0" IsChecked="{Binding UseSystemNumbers}">
          <TextBlock TextWrapping="Wrap"><l:WordsInline Key="parameters.culture.system"><Binding Path="SystemCulture"/></l:WordsInline></TextBlock>
        </CheckBox>
      </StackPanel>
    </c:DemoCard>
    <!-- /card -->
  </StackPanel>
</UserControl>
