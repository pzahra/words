<Solution>
  <Folder Name="/Words/">
    <Project Path="Localization-Core/Localization-Core.csproj" />
    <Project Path="Localization-Wpf/Localization-Wpf.csproj" />
    <Project Path="Localization-Ava/Localization-Ava.csproj" />
  </Folder>
  <Folder Name="/Analyzer/">
    <Project Path="LocalizationAnalyzer/LocalizationAnalyzer/LocalizationAnalyzer.csproj" />
    <Project Path="LocalizationAnalyzer/LocalizationAnalyzer.Package/LocalizationAnalyzer.Package.csproj" />
    <Project Path="LocalizationAnalyzer/LocalizationAnalyzer.Test/LocalizationAnalyzer.Test.csproj" />
    <Project Path="LocalizationAnalyzer/LocalizationAnalyzer.Vsix/LocalizationAnalyzer.Vsix.csproj" />
  </Folder>
  <Folder Name="/Editor/">
    <Project Path="WordsEdit/WordsEdit.csproj" />
    <Project Path="WordsEdit.Tests/WordsEdit.Tests.csproj" />
  </Folder>
  <Folder Name="/Rider Plugin/">
    <!--
      Only the cheap, shared .NET pieces are part of this solution. The ReSharper-SDK plugin itself
      (WordsXaml/src/dotnet/WordsXaml/WordsXaml.csproj) is deliberately NOT referenced here — it pulls the
      large JetBrains SDK. Build it via WordsXaml/src/dotnet/WordsXaml.slnx or `./gradlew` in WordsXaml/.
    -->
    <Project Path="WordsXaml/src/dotnet/WordsXaml.Core/WordsXaml.Core.csproj" />
    <Project Path="WordsXaml/src/dotnet/WordsXaml.Tests/WordsXaml.Tests.csproj" />
    <File Path="WordsXaml/README.md" />
    <File Path="WordsXaml/build.gradle.kts" />
  </Folder>
  <Folder Name="/Samples/">
    <Project Path="Sample-Wpf/Sample-Wpf.csproj" />
    <Project Path="Sample-Ava/Sample-Ava.csproj" />
    <Project Path="Sample-Console/Sample-Console.csproj" />
    <Project Path="LocalizedSample/LocalizedSample.csproj" />
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
  </Folder>
</Solution>
